#!/bin/bash
# loveos-session - the boot loop, run by loveos.service.
#
# The menu (a LÖVE 11.5 app) writes the chosen entry to $R3I6NOS_NEXT as
# "<type><TAB><path>" and quits; this loop runs it through run_app.sh, so
# the menu's memory is free while a game runs, then shows the menu again.
#
# A "system<TAB>poweroff" request (Settings > Shutdown) ends the loop; see r3i6nos-poweroff.
#
# Overrides, for tests on a laptop: R3I6NOS_NEXT_DIR, R3I6NOS_MENU,
# R3I6NOS_MENU_LOVE, R3I6NOS_RUN_APP, R3I6NOS_WATCHER, R3I6NOS_GPU_DIR, and R3I6NOS_ONCE=1
# (one pass, then exit).

set -u

NEXT_DIR="${R3I6NOS_NEXT_DIR:-/run/loveos}"
MENU="${R3I6NOS_MENU:-/opt/loveos/menu}"
MENU_LOVE="${R3I6NOS_MENU_LOVE:-/opt/love/11.5/bin/love}"
RUN_APP="${R3I6NOS_RUN_APP:-/usr/local/bin/run_app.sh}"
WATCHER="${R3I6NOS_WATCHER:-/usr/local/bin/deb_watcher.py}"

GPU_DIR="${R3I6NOS_GPU_DIR:-/opt/libmali}"

export SDL_VIDEODRIVER="${SDL_VIDEODRIVER:-kmsdrm}"
export SDL_NOMOUSE=1
export R3I6NOS_NEXT="$NEXT_DIR/next"

# The stock kernel is 4.x, where Mesa's panfrost cannot run: the GPU is driven by the
# vendor's Mali blob, injected from the user's own card (scripts/inject-rootfs.sh) into
# /opt/libmali. Its libEGL, libGLESv2 and libgbm must come first, and it offers OpenGL ES
# only, which LÖVE needs to be told to use. Without it, Mesa's software renderer is used.
if [ -d "$GPU_DIR" ]; then
    export LD_LIBRARY_PATH="$GPU_DIR${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"
    export LOVE_GRAPHICS_USE_OPENGLES=1
fi

mkdir -p "$NEXT_DIR"

while true; do
    # Pick up any .deb dropped on the card since the last pass.
    "$WATCHER" || echo "loveos-session: deb_watcher failed" >&2

    rm -f "$R3I6NOS_NEXT"
    "$MENU_LOVE" "$MENU"

    if [ -f "$R3I6NOS_NEXT" ]; then
        IFS=$'\t' read -r type target < "$R3I6NOS_NEXT"
        if [ "$type" = system ]; then
            # Settings > Shutdown. This user cannot power off; leave a flag and exit cleanly, and
            # loveos.service's ExecStopPost (root) runs r3i6nos-poweroff, which acts on it.
            if [ "$target" = poweroff ]; then
                : > "$NEXT_DIR/poweroff"
                exit 0
            fi
            echo "loveos-session: unknown system request: $target" >&2
            sleep 1
            continue
        fi
        "$RUN_APP" "$type" "$target" || echo "loveos-session: $type $target exited $?" >&2
    else
        # Menu quit or crashed without choosing: don't spin.
        sleep 1
    fi

    [ "${R3I6NOS_ONCE:-}" = 1 ] && exit 0
done
