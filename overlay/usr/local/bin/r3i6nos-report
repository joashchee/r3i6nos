#!/usr/bin/env python3
# RUNS: 3
# NEEDS: Leave the pad alone while it runs (about a minute).
# RUN 1: Nothing in the USB-C (OTG) port, charger out
# RUN 1: (the power numbers need the battery).
# RUN 2: The wired Ethernet adapter in the port, its
# RUN 2: cable to a router or a computer.
# RUN 3: A plain USB cable from the port to a computer
# RUN 3: (it charges, so power is skipped: that is fine).
"""r3i6nos-report - the device report of r3i6nos itself (docs/DEVICE-REPORTS.md, docs/STORAGE.md).

    r3i6nos-report [--from-settings] [--quiet]

Checks and measures what only the unit can answer about the system, and writes r3i6nos/r36s-report.txt on the data card when one is
mounted (so the boot card can stay in), else on the system card, for Claude to read in the r3i6nos repo. Settings > Device reports
starts it (it is linked into /opt/loveos/bin as a report); over SSH, run `r3i6nos-report`. It runs as loveos and needs no root.
It must be run three times, once for each USB setup (the `# RUNS` and `# RUN k` lines at the top, which the menu shows); the menu passes
R3I6NOS_REPORT_SETUP=k/3, and each run writes r36s-report-run<k>.txt (r36s-report.txt is a copy of the latest).

Sections: system (the build, kernel, CPU, memory), setup (whether r3i6nos-setup made this card, docs/TWO-SLOT-SETUP.md), boot (units that failed, how long boot took), sound (the RK817's Playback
Path, the headphone jack, the volume keys and the mixer, from r3i6nos-sound), clock (r3i6nos-clock status), storage (every mmc disk and slot, what
r3i6nos-cards mounted, the kernel's filesystems, loop devices, and on each mounted card a write/rename/read/delete check and its speed),
power (what the background work costs the battery: the hot-plug daemon, the menu, the periodic jobs; the idle draw in mW; docs/POWER.md),
usb gadget and usb ethernet (whether the OTG port can act as a network card for a computer, or host a wired adapter: the answers the screen
mirror needs, ROADMAP section 28, docs/SCREEN-MIRROR.md; read-only, from /proc and /sys).

Standard library only. Overrides, for tests: R3I6NOS_ETC (/etc), R3I6NOS_PROC (/proc), R3I6NOS_SYS (/sys), R3I6NOS_DEV (/dev),
R3I6NOS_CARDS_STATE (/run/r3i6nos/cards), R3I6NOS_REPORT_DIR (the folder to write in), R3I6NOS_REPORT_MB (16: the speed test's size),
R3I6NOS_SETUP_VAR, R3I6NOS_SETUP_RUN, R3I6NOS_SETUP_BOOT (where r3i6nos-setup leaves its record, state and report),
R3I6NOS_SOUND (r3i6nos-sound), R3I6NOS_HOTPLUG (r3i6nos-hotplug),
R3I6NOS_CLOCK (r3i6nos-clock), and for the power section (docs/POWER.md): R3I6NOS_REPORT_POWER_S (30: seconds per measuring window),
R3I6NOS_BATTERY (r3i6nos-battery), R3I6NOS_MODULES (/lib/modules), R3I6NOS_BOOTSTATE_CMD (r3i6nos-bootstate), R3I6NOS_MENU_MATCH (/opt/loveos/menu: how the menu's process
is told), R3I6NOS_POWER_AB (1: do the stop-and-compare even when not root, tests).
"""
import gzip
import os
import re
import resource
import shutil
import signal
import subprocess
import sys
import tempfile
import time
from pathlib import Path

APP = "r3i6nos"          # read by the menu's Settings > Device reports (menu/reports.lua) for the entry's name
PACKAGE = "r3i6nos"
ENV = os.environ.get
ETC = Path(ENV("R3I6NOS_ETC", "/etc"))
PROC = Path(ENV("R3I6NOS_PROC", "/proc"))
SYS = Path(ENV("R3I6NOS_SYS", "/sys"))
DEV = Path(ENV("R3I6NOS_DEV", "/dev"))
STATE = Path(ENV("R3I6NOS_CARDS_STATE", "/run/r3i6nos/cards"))
MB = int(ENV("R3I6NOS_REPORT_MB", "16"))
REPORT_DIR = ENV("R3I6NOS_REPORT_DIR")
SOUND = ENV("R3I6NOS_SOUND", "/usr/local/bin/r3i6nos-sound")
HOTPLUG = ENV("R3I6NOS_HOTPLUG", "/usr/local/bin/r3i6nos-hotplug")
CLOCK = ENV("R3I6NOS_CLOCK", "/usr/local/bin/r3i6nos-clock")
BOOTSTATE = Path(ENV("R3I6NOS_BOOTSTATE", "/run/r3i6nos/boot-state"))   # r3i6nos-bootstate (root) writes it: systemctl answers only root
SETUP_VAR = Path(ENV("R3I6NOS_SETUP_VAR", "/var/lib/r3i6nos"))        # r3i6nos-setup's record (docs/TWO-SLOT-SETUP.md)
SETUP_RUN = Path(ENV("R3I6NOS_SETUP_RUN", "/run/r3i6nos"))
SETUP_BOOT = Path(ENV("R3I6NOS_SETUP_BOOT", "/boot"))
PROGRESS = ENV("R3I6NOS_REPORT_PROGRESS")   # set by the menu (menu/reports.lua): where to say how far it has got
POWER_S = float(ENV("R3I6NOS_REPORT_POWER_S", "30"))
MODULES = Path(ENV("R3I6NOS_MODULES", "/lib/modules"))
BATTERY_CMD = ENV("R3I6NOS_BATTERY", "/usr/local/bin/r3i6nos-battery")
BOOTSTATE_CMD = ENV("R3I6NOS_BOOTSTATE_CMD", "/usr/local/bin/r3i6nos-bootstate")
MENU_MATCH = ENV("R3I6NOS_MENU_MATCH", "/opt/loveos/menu")
# the goals the power section checks against (docs/POWER.md): a goal missed is a FAIL line, not a silent number
GOAL_DAEMON_CPU = 1.0        # % of one core, the hot-plug daemon
GOAL_DAEMON_WAKEUPS = 4.0    # context switches a second, the hot-plug daemon (its poll is once a second)
GOAL_JOBS_CPU = 0.05         # % of one core, the periodic jobs together, averaged over an hour
GOAL_DAEMON_MW = 20.0        # mW the daemon may cost beyond the measuring noise
WANT_FS = ("exfat", "vfat", "ext4", "squashfs")


def read(path):
    try:
        return Path(path).read_text(errors="replace").replace("\0", "").strip()
    except OSError:
        return None


def keyvals(path):
    out = {}
    for line in (read(path) or "").splitlines():
        k, sep, v = line.partition("=")
        if sep:
            out[k.strip()] = v.strip()
    return out


def setup_run():
    """(k, n) when the menu says this is run k of n of a report that must be run several times (R3I6NOS_REPORT_SETUP=k/n), else None."""
    m = re.fullmatch(r"(\d)/(\d)", ENV("R3I6NOS_REPORT_SETUP", ""))
    if m and 1 <= int(m.group(1)) <= int(m.group(2)) and int(m.group(2)) >= 2:
        return int(m.group(1)), int(m.group(2))
    return None


class Report:
    def __init__(self, folder, how, version, card, quiet=False):
        self.quiet = quiet
        self.counts = {"PASS": 0, "FAIL": 0, "INFO": 0, "SKIP": 0}
        os.makedirs(folder, exist_ok=True)
        self.run = setup_run()
        # one file for each run of a several-run report, so the next run does not replace the last; r36s-report.txt is a copy of the latest
        self.latest = os.path.join(folder, "r36s-report.txt")
        self.path = os.path.join(folder, f"r36s-report-run{self.run[0]}.txt") if self.run else self.latest
        self.tmp = self.path + ".tmp"
        self.f = open(self.tmp, "w", encoding="ascii", errors="replace", newline="\n")
        self.done_steps, self.steps = 0, 1
        self.raw("# r3i6nos device report\n"
                 f"app: {APP} {version} ({PACKAGE})\n"
                 f"made: {time.strftime('%Y-%m-%d %H:%M:%S')}\n"
                 f"how: {how}\n"
                 + (f"run: {self.run[0]} of {self.run[1]} (one report for each setup: give Claude all {self.run[1]} files)\n" if self.run else "")
                 + f"for: Claude. Copy r3i6nos/{os.path.basename(self.path)} from the {card} to a computer and give it to Claude in the r3i6nos repo.\n")

    def step(self, doing):
        """Say what is being checked now, for the menu's progress bar (docs/DEVICE-REPORTS.md, "Progress"). Never fails the report."""
        self.done_steps += 1
        if not PROGRESS:
            return
        try:
            tmp = PROGRESS + ".tmp"
            with open(tmp, "w") as f:
                f.write(f"step={min(self.done_steps, self.steps)}\nsteps={self.steps}\ndoing={' '.join(doing.split())}\nfile={self.path}\n")
            os.replace(tmp, PROGRESS)
        except OSError:
            pass

    def raw(self, text):
        self.f.write(text)
        if not self.quiet:
            sys.stdout.write(text)
            sys.stdout.flush()

    def line(self, status, key, value):
        key = " ".join(str(key).replace(":", " ").split())
        value = " ".join(str(value).split())
        self.counts[status] += 1
        self.raw(f"{status} {key}: {value}\n")

    def section(self, name):
        self.raw(f"\n== {name} ==\n")

    def close(self):
        c = self.counts
        self.section("summary")
        self.raw(f"PASS {c['PASS']}  FAIL {c['FAIL']}  INFO {c['INFO']}  SKIP {c['SKIP']}\nend\n")
        self.f.flush()
        os.fsync(self.f.fileno())
        self.f.close()
        os.replace(self.tmp, self.path)
        if self.run:
            tmp = self.latest + ".tmp"
            shutil.copyfile(self.path, tmp)
            os.replace(tmp, self.latest)


def run(cmd, timeout=10):
    """stdout, or None when it could not run or failed."""
    code, out, _ = run_full(cmd, timeout)
    return out if code == 0 else None


def run_full(cmd, timeout=10):
    """(exit status or None, stdout, the first line of stderr): for checks that should say why they failed."""
    try:
        r = subprocess.run(cmd, capture_output=True, text=True, timeout=timeout)
    except (OSError, subprocess.SubprocessError) as e:
        return None, "", str(e)
    err = (r.stderr or "").strip().splitlines()
    return r.returncode, r.stdout, err[0] if err else ""


def gb(n):
    return f"{n / 1e9:.1f} GB"


# ---- sections -------------------------------------------------------------------------------------------------------------------

def system(r, rel):
    r.step("the build and the system")
    r.section("system")
    if rel:
        r.line("INFO", "build", f"r3i6nos {rel.get('VERSION', '?')}, commit {rel.get('COMMIT', '?')[:10]} ({rel.get('COMMIT_DATE', '?')}), "
                                f"built {rel.get('BUILT', '?')} by {rel.get('BUILT_BY', '?')}" + (", modified" if rel.get("MODIFIED") == "1" else ""))
    else:
        r.line("FAIL", "build", "no /etc/r3i6nos-release")
    u = os.uname()
    r.line("INFO", "kernel", f"{u.sysname} {u.release} {u.machine}")
    model = read(PROC / "device-tree" / "model")
    if model:
        r.line("INFO", "board", model)
    cpus = sum(1 for ln in (read(PROC / "cpuinfo") or "").splitlines() if ln.startswith("processor"))
    khz = read(SYS / "devices/system/cpu/cpu0/cpufreq/cpuinfo_max_freq")
    r.line("INFO", "cpu", f"{cpus} CPUs" + (f", {int(khz) // 1000} MHz max" if khz and khz.isdigit() else ""))
    mem = {}
    for ln in (read(PROC / "meminfo") or "").splitlines():
        k, _, v = ln.partition(":")
        mem[k] = v.strip()
    if "MemTotal" in mem:
        r.line("INFO", "memory", f"total {mem['MemTotal']}, available {mem.get('MemAvailable', '?')}")


def setup_section(r):
    """How this card was made: by r3i6nos-setup (the unit prepared it from the original card), or not."""
    r.section("setup")
    done = keyvals(SETUP_VAR / "setup-done")
    state = keyvals(SETUP_RUN / "setup-state")
    if done:
        r.line("INFO", "made by r3i6nos-setup", f"{done.get('DATE', '?')}, build {done.get('VERSION', '?')}, original card id {done.get('SOURCE_ID', '?')}")
        r.line("INFO", "backup of the original", done.get("BACKUP", "none"))
    else:
        r.line("SKIP", "made by r3i6nos-setup", "no record: this card was not set up by the unit (or it was made with the host scripts)")
    if state:
        r.line("INFO", "this boot", state.get("mode", "?") + (f", {state['why']}" if state.get("why") else ""))
    text = read(SETUP_BOOT / "r3i6nos-setup-report.txt")
    if text:
        m = re.search(r"^PASS (\d+)  FAIL (\d+)", text, re.M)
        if m:
            r.line("PASS" if m.group(2) == "0" else "FAIL", "setup report on BOOT", f"{m.group(1)} PASS, {m.group(2)} FAIL (r3i6nos-setup-report.txt on the BOOT drive)")


def boot_state():
    """{key: value} from r3i6nos-bootstate's file, or {} when it is not there yet."""
    text = read(BOOTSTATE) or ""
    return {k: v for k, _, v in (ln.partition(": ") for ln in text.splitlines()) if k}


def state_line(r, state):
    # running: the boot finished and nothing failed; degraded: something failed; starting: jobs are still waiting
    r.line("PASS" if state == "running" else ("FAIL" if state in ("degraded", "maintenance") else "INFO"), "system state", state)


def jobs_line(r, waiting):
    r.line("PASS" if not waiting else "INFO", "jobs waiting", ", ".join(waiting[:8]) + (" ..." if len(waiting) > 8 else "") if waiting else "none")


def boot(r):
    r.step("how the boot went")
    r.section("boot")
    out = run(["systemctl", "list-units", "--failed", "--plain", "--no-legend", "--no-pager"])
    if out is None:
        # Not root, and no D-Bus in the image: systemctl cannot reach systemd. r3i6nos-bootstate (root, on a timer) writes what it says.
        st = boot_state()
        if not st:
            r.line("SKIP", "boot", f"systemctl answers only root here (no D-Bus), and {BOOTSTATE} is not written yet (a minute after boot)")
        else:
            r.line("INFO", "boot facts from", f"{BOOTSTATE}, written {st.get('written', '?')} (systemctl answers only root here)")
            failed = [] if st.get("failed units", "none") == "none" else st["failed units"].split()
            r.line("PASS" if not failed else "FAIL", "failed units", ", ".join(failed) if failed else "none")
            if st.get("system state"):
                state_line(r, st["system state"])
            jobs = st.get("jobs waiting", "none")
            jobs_line(r, [] if jobs == "none" else jobs.split())
            t = st.get("boot time", "")
            r.line("INFO" if t.startswith("Startup finished") else "SKIP", "boot time", t.replace("Startup finished in ", "") or "not written")
    else:
        failed = [ln.split()[0] for ln in out.splitlines() if ln.strip()]
        r.line("PASS" if not failed else "FAIL", "failed units", ", ".join(failed) if failed else "none")
        code, state, err = run_full(["systemctl", "is-system-running"])
        state = state.strip()
        if state:
            state_line(r, state)
        else:
            r.line("SKIP", "system state", err or "systemctl did not answer")
        code, jobs, err = run_full(["systemctl", "list-jobs", "--no-legend", "--no-pager", "--plain"])
        if code is not None and not err:
            jobs_line(r, [ln.split()[1] for ln in jobs.splitlines() if len(ln.split()) >= 2])
        code, t, err = run_full(["systemd-analyze", "time", "--no-pager"])
        if code == 0 and t.strip():
            r.line("INFO", "boot time", t.strip().splitlines()[0].replace("Startup finished in ", ""))
        else:
            r.line("SKIP", "boot time", f"systemd-analyze: {err}" if err else "systemd-analyze did not answer")
    up = read(PROC / "uptime")
    if up:
        r.line("INFO", "up for", f"{float(up.split()[0]) / 60:.1f} min")


def sound(r):
    """The speaker's state (r3i6nos-sound status): the RK817 codec is silent while its Playback Path is OFF."""
    r.step("the sound output")
    r.section("sound")
    out = run([SOUND, "status"])
    if out is None:
        r.line("SKIP", "sound", "r3i6nos-sound did not answer")
        return
    volume = False
    for ln in out.splitlines():
        key, _, val = ln.partition(": ")
        if key.endswith("playback path") and val != "none":
            cur = val.split(" ", 1)[0]
            r.line("PASS" if cur in ("SPK", "HP", "HP_NO_MIC", "SPK_HP") else "FAIL", key, val)
        elif key in ("mixer Volume", "mixer Boost"):
            volume = True
            r.line("PASS", key, val)
        elif key:
            r.line("INFO", key, val)
    if not volume:   # /etc/asound.conf's software volumes (docs/SOUND.md): without them the volume keys and the mixer do nothing
        r.line("FAIL", "mixer Volume", "missing: the software volumes were not made (is /etc/asound.conf in place?)")
    state = (run(["systemctl", "is-active", "r3i6nos-sound.service"]) or "").strip() or boot_state().get("unit r3i6nos-sound.service", "")
    r.line("INFO", "jack follower", state or "unknown")
    r.line("INFO", "heard", "not measured: listen for the menu's sounds (speaker), then with headphones in")
    # what is plugged in, and whether the toast's watcher runs (docs/HOTPLUG.md); the sysfs names it reads have never been read on the unit
    plugged = run([HOTPLUG, "status"])
    if plugged is None:
        r.line("SKIP", "hotplug", "r3i6nos-hotplug did not answer")
    else:
        for ln in plugged.splitlines():
            key, _, val = ln.partition(": ")
            r.line("INFO", "plugged " + key, val)
        hstate = (run(["systemctl", "is-active", "r3i6nos-hotplug.service"]) or "").strip() or boot_state().get("unit r3i6nos-hotplug.service", "")
        r.line("PASS" if hstate == "active" else "INFO", "hotplug watcher", hstate or "unknown")


def clock(r):
    """The clock (r3i6nos-clock status, docs/CLOCK.md): this report's own timestamps are only as good as it is."""
    r.step("the clock")
    r.section("clock")
    out = run([CLOCK, "status"])
    if out is None:
        r.line("SKIP", "clock", "r3i6nos-clock did not answer")
        return
    for ln in out.splitlines():
        key, _, val = ln.partition(": ")
        if key == "set by a person":
            r.line("PASS" if val != "no" else "FAIL", key, val if val != "no" else "no: set it in Settings > Date and time (the times here may be off)")
        elif key:
            r.line("INFO", key, val)


def disks():
    """[(name, bytes, removable)] for every mmc disk."""
    out = []
    try:
        names = sorted(p.name for p in (SYS / "block").iterdir())
    except OSError:
        return out
    for n in names:
        if re.fullmatch(r"mmcblk\d+", n):
            sectors = read(SYS / "block" / n / "size")
            out.append((n, int(sectors) * 512 if sectors and sectors.isdigit() else 0, read(SYS / "block" / n / "removable") == "1"))
    return out


def mounts():
    out = {}
    for line in (read(PROC / "mounts") or "").splitlines():
        p = line.split()
        if len(p) >= 4:
            out[p[1]] = (p[0], p[2], p[3])
    return out


def speed(r, label, folder):
    path = os.path.join(folder, ".r36s-report-speed")
    block = os.urandom(1 << 20)
    try:
        t0 = time.monotonic()
        fd = os.open(path, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o644)
        try:
            for _ in range(MB):
                os.write(fd, block)
            os.fsync(fd)
        finally:
            os.close(fd)
        w = time.monotonic() - t0
        fd = os.open(path, os.O_RDONLY)
        try:
            if hasattr(os, "posix_fadvise"):
                os.posix_fadvise(fd, 0, 0, os.POSIX_FADV_DONTNEED)  # read from the card, not from memory
            t0 = time.monotonic()
            while os.read(fd, 1 << 20):
                pass
            rd = time.monotonic() - t0
        finally:
            os.close(fd)
        r.line("INFO", f"{label} write speed", f"{MB / w:.1f} MB/s ({MB} MB, synced)")
        r.line("INFO", f"{label} read speed", f"{MB / rd:.1f} MB/s" if rd > 0 else "too fast to time")
    except OSError as e:
        r.line("FAIL", f"{label} speed", e)
    finally:
        try:
            os.remove(path)
        except OSError:
            pass


def card_check(r, label, folder):
    a, b = os.path.join(folder, ".r36s-report-test"), os.path.join(folder, ".r36s-report-test.tmp")
    try:
        os.makedirs(folder, exist_ok=True)
        with open(a, "w") as f:
            f.write("first\n")
        with open(b, "w") as f:
            f.write("second\n")
        os.replace(b, a)
        with open(a) as f:
            ok = f.read() == "second\n"
        os.remove(a)
        r.line("PASS" if ok else "FAIL", f"{label} write, rename over, read, delete", "ok" if ok else "read back different text")
    except OSError as e:
        r.line("FAIL", f"{label} write, rename over, read, delete", e)
    for p in (a, b):
        try:
            os.remove(p)
        except OSError:
            pass


def mounted_cards(cards):
    """The cards to check and time: (state key, label, mount point), only those mounted."""
    m = mounts()
    out = []
    for role in ("SYSTEM", "DATA"):
        at = cards.get(f"{role}_AT", "none")
        if at != "none" and at in m:
            out.append((role, "system card" if role == "SYSTEM" else "data card", at))
    return out


def storage(r, cards):
    r.step("the card slots and filesystems")
    r.section("storage")
    found = disks()
    boot_disk = cards.get("BOOT_DISK", "none")
    if not found:
        r.line("SKIP", "mmc disks", "none in /sys/block")
    for name, size, removable in found:
        role = "boot (system card)" if name == boot_disk else "other (data card?)"
        r.line("INFO", f"disk {name}", f"{gb(size)}, {role}" + (", removable" if removable else ""))
    if found:
        r.line("PASS" if len(found) >= 2 else "INFO", "cards in the slots", f"{len(found)}" + ("" if len(found) >= 2 else " (put a card in TF2 to test the data card)"))
    try:
        hosts = sorted(p.name for p in (SYS / "class" / "mmc_host").iterdir())
    except OSError:
        hosts = []
    if hosts:
        r.line("INFO", "mmc hosts", ", ".join(hosts))
    if not cards:
        r.line("FAIL", "r3i6nos-cards", f"no {STATE}: the cards service did not run")
    else:
        for role in ("SYSTEM", "DATA"):
            dev, fs, at = cards.get(f"{role}_DEV", "none"), cards.get(f"{role}_FS", "none"), cards.get(f"{role}_AT", "none")
            name = "system card" if role == "SYSTEM" else "data card"
            if dev == "none":
                r.line("INFO", name, "none found")
            elif at == "none":
                r.line("FAIL", name, f"{dev} ({fs}) found but not mounted")
            else:
                r.line("PASS", name, f"{dev} ({fs}) on {at}")
    have = set()
    for ln in (read(PROC / "filesystems") or "").splitlines():
        have.add(ln.split()[-1])
    if have:
        for fs in WANT_FS:
            r.line("PASS" if fs in have else ("FAIL" if fs == "squashfs" else "INFO"), f"kernel {fs}", "yes" if fs in have else "no")
    else:
        r.line("SKIP", "kernel filesystems", "no /proc/filesystems")
    loops = (DEV / "loop-control").exists() or (DEV / "loop0").exists()
    r.line("PASS" if loops else "FAIL", "loop devices", "yes" if loops else "no /dev/loop-control or /dev/loop0")
    m = mounts()
    for role, label, at in mounted_cards(cards):
        dev, fs, opts = m[at]
        try:
            st = os.statvfs(at)
            r.line("INFO", f"{label} space", f"{gb(st.f_bavail * st.f_frsize)} free of {gb(st.f_blocks * st.f_frsize)} ({fs}, {opts.split(',')[0]})")
        except OSError as e:
            r.line("FAIL", f"{label} space", e)
        folder = os.path.join(at, "r3i6nos")
        r.step(f"the {label}: write, rename, read, delete")
        card_check(r, label, folder)
        r.step(f"the {label}: speed ({MB} MB)")
        speed(r, label, folder)


def where(cards):
    """(folder, which card): the data card when one is mounted, so the boot card can stay in."""
    data, system_at = cards.get("DATA_AT", "none"), cards.get("SYSTEM_AT", "none")
    card = "data card" if data != "none" and data != system_at else "system card"
    if REPORT_DIR:
        return REPORT_DIR, card
    root = data if data != "none" else (system_at if system_at != "none" else "/roms")
    return os.path.join(root, "r3i6nos"), card


# ---- power: what the background work costs (docs/POWER.md) ------------------------------------------------------------------------

CLK = os.sysconf("SC_CLK_TCK") if hasattr(os, "sysconf") else 100


def find_pids(*needles):
    """Pids whose command line holds every needle (a name, an argument)."""
    out = []
    try:
        names = [p.name for p in PROC.iterdir() if p.name.isdigit()]
    except OSError:
        return out
    for n in names:
        cmd = (read(PROC / n / "cmdline") or "").replace("\0", " ")
        if cmd and all(x in cmd for x in needles) and n != str(os.getpid()):
            out.append(int(n))
    return sorted(out)


def proc_snap(pid):
    """CPU ticks, context switches and resident kB of one process, or None when it is gone."""
    stat = read(PROC / str(pid) / "stat")
    if not stat or ")" not in stat:
        return None
    rest = stat.rsplit(")", 1)[1].split()
    try:
        ticks = int(rest[11]) + int(rest[12])
    except (IndexError, ValueError):
        return None
    st = {k: v for k, _, v in (ln.partition(":") for ln in (read(PROC / str(pid) / "status") or "").splitlines())}
    num = lambda k: int((st.get(k) or "0").split()[0])
    return {"ticks": ticks, "ctx": num("voluntary_ctxt_switches") + num("nonvoluntary_ctxt_switches"), "rss": num("VmRSS"),
            "name": (st.get("Name") or str(pid)).strip()}


def sys_snap():
    """Total and idle CPU ticks, interrupts and context switches since boot, from /proc/stat."""
    out = {"total": 0, "idle": 0, "intr": 0, "ctxt": 0}
    for ln in (read(PROC / "stat") or "").splitlines():
        p = ln.split()
        if p and p[0] == "cpu":
            v = [int(x) for x in p[1:]]
            out["total"], out["idle"] = sum(v), v[3] + (v[4] if len(v) > 4 else 0)
        elif p and p[0] in ("intr", "ctxt") and len(p) > 1:
            out[p[0]] = int(p[1])
    return out


def all_snaps():
    out = {}
    try:
        names = [p.name for p in PROC.iterdir() if p.name.isdigit()]
    except OSError:
        return out
    for n in names:
        s = proc_snap(int(n))
        if s:
            out[int(n)] = s
    return out


def pct(before, after, wall):
    """CPU as % of one core between two snapshots of one process."""
    return max(0, after["ticks"] - before["ticks"]) / CLK / wall * 100 if wall > 0 else 0.0


def supply():
    base = SYS / "class/power_supply"
    try:
        names = sorted(p.name for p in base.iterdir())
    except OSError:
        return None
    for n in names:
        if (read(base / n / "type") or "").lower() == "battery":
            return base / n
    for n in names:
        if "bat" in n.lower() or n.lower().startswith("bms"):
            return base / n
    return None


def num(path):
    try:
        return int(read(path))
    except (TypeError, ValueError):
        return None


def draw_mw(b):
    """The battery's draw now in mW (current x voltage), or None when it does not report both."""
    i, v = num(b / "current_now"), num(b / "voltage_now")
    return abs(i) * v / 1e9 if i is not None and v else None


def measure(seconds, pids, b=None):
    """Watch for `seconds`: CPU and wakeups of `pids` (a name -> pid map), of the whole system and of every process, and the battery's draw once a second."""
    names = list(pids)
    s0, p0, a0, t0 = sys_snap(), {n: proc_snap(p) for n, p in pids.items()}, all_snaps(), time.monotonic()
    draws = []
    end = t0 + seconds
    while True:
        if b is not None and (d := draw_mw(b)) is not None:
            draws.append(d)
        left = end - time.monotonic()
        if left <= 0:
            break
        time.sleep(min(1.0, left))
    wall = max(time.monotonic() - t0, 1e-6)
    s1, a1 = sys_snap(), all_snaps()
    procs = {}
    for n in names:
        p1 = proc_snap(pids[n])
        if p0[n] and p1:
            procs[n] = {"cpu": pct(p0[n], p1, wall), "wake": max(0, p1["ctx"] - p0[n]["ctx"]) / wall, "rss": p1["rss"]}
    dt = s1["total"] - s0["total"]
    top = sorted(((pct(a0[p], a1[p], wall), a1[p]["name"], p) for p in a1 if p in a0), reverse=True)[:5]
    return {"wall": wall, "procs": procs, "draws": draws, "top": top,
            "busy": (100.0 * (dt - (s1["idle"] - s0["idle"])) / dt) if dt > 0 else None,
            "intr": (s1["intr"] - s0["intr"]) / wall, "ctxt": (s1["ctxt"] - s0["ctxt"]) / wall}


def mean(xs):
    return sum(xs) / len(xs) if xs else None


def job_cost(cmd, env, runs=3):
    """CPU seconds and wall seconds one run of a periodic job takes, or None when it could not run (it may be root's)."""
    cpu, wall, ok = 0.0, 0.0, 0
    for _ in range(runs):
        r0, t0 = resource.getrusage(resource.RUSAGE_CHILDREN), time.monotonic()
        try:
            subprocess.run(cmd, env=dict(os.environ, **env), capture_output=True, timeout=30)
        except (OSError, subprocess.SubprocessError):
            return None
        r1 = resource.getrusage(resource.RUSAGE_CHILDREN)
        cpu += (r1.ru_utime + r1.ru_stime) - (r0.ru_utime + r0.ru_stime)
        wall += time.monotonic() - t0
        ok += 1
    return cpu / ok, wall / ok


def power_section(r):
    r.section("power")
    b = supply()
    if b is None:
        r.line("SKIP", "battery", "no battery supply found, so no draw can be measured (the CPU and wake-up costs below still are)")
        status = None
    else:
        status = read(b / "status")
        r.line("INFO", "battery supply", f"{b.name}: {read(b / 'capacity') or '?'}%, {status or 'status not reported'}")
        i, v = num(b / "current_now"), num(b / "voltage_now")
        r.line("INFO" if i is not None else "SKIP", "current_now", f"{abs(i) / 1000:.0f} mA" + (f" at {v / 1e6:.2f} V" if v else "") if i is not None else "not reported: the draw cannot be measured here, only CPU time and wake-ups")
    discharging = b is not None and status == "Discharging" and draw_mw(b) is not None
    if b is not None and status != "Discharging":
        r.line("SKIP", "draw", f"the battery says {status or 'nothing'}, not Discharging: unplug the power and run again for the draw in mW")

    hp = find_pids("r3i6nos-hotplug", "start")
    menu = find_pids(MENU_MATCH)
    pids = {}
    if hp:
        pids["hotplug"] = hp[0]
    if menu:
        pids["menu"] = menu[0]

    r.step(f"the unit idle for {POWER_S:.0f} s: CPU, wake-ups, draw")
    base = measure(POWER_S, pids, b if discharging else None)
    r.line("INFO", "window", f"{base['wall']:.0f} s with the menu showing, nothing pressed")
    if base["busy"] is not None:
        r.line("INFO", "system busy", f"{base['busy']:.1f}% of all CPUs, {base['intr']:.0f} interrupts/s, {base['ctxt']:.0f} context switches/s")
    for cpu, name, pid in base["top"]:
        r.line("INFO", f"busiest {name}", f"{cpu:.2f}% of a core (pid {pid})")
    if discharging and base["draws"]:
        d = base["draws"]
        r.line("INFO", "idle draw", f"{mean(d):.0f} mW mean (min {min(d):.0f}, max {max(d):.0f}, {len(d)} readings)")
        full, volt = num(b / "charge_full"), num(b / "voltage_now")
        cap = num(b / "capacity")
        if full and volt and cap is not None:
            wh = full * volt / 1e12 * cap / 100
            r.line("INFO", "idle time left", f"{wh / (mean(d) / 1000):.1f} h at this draw ({cap}% of {full / 1000:.0f} mAh)")

    r.step("the hot-plug daemon")
    h = base["procs"].get("hotplug")
    if h is None:
        r.line("FAIL", "hotplug daemon", "r3i6nos-hotplug start is not running, so its cost cannot be measured (docs/HOTPLUG.md)")
    else:
        r.line("PASS" if h["cpu"] <= GOAL_DAEMON_CPU else "FAIL", "hotplug cpu", f"{h['cpu']:.2f}% of a core (goal at most {GOAL_DAEMON_CPU:.1f}%)")
        r.line("PASS" if h["wake"] <= GOAL_DAEMON_WAKEUPS else "FAIL", "hotplug wakeups", f"{h['wake']:.1f}/s (goal at most {GOAL_DAEMON_WAKEUPS:.1f}; its poll is once a second)")
        r.line("INFO", "hotplug memory", f"{h['rss']} kB resident")
    cost = job_cost([HOTPLUG, "status"], {})
    r.line("INFO" if cost else "SKIP", "hotplug one look", f"{cost[0] * 1000:.0f} ms CPU, {cost[1] * 1000:.0f} ms wall (status: every sysfs read the daemon does each poll, plus Python's start)" if cost else "r3i6nos-hotplug status would not run")
    m = base["procs"].get("menu")
    if m is None:
        r.line("SKIP", "menu", f"no process matching {MENU_MATCH} (run from Settings > Device reports, so the menu is showing)")
    else:
        r.line("INFO", "menu cpu", f"{m['cpu']:.1f}% of a core while showing, {m['rss']} kB resident (every loop polls the toast; the battery is read every 10 s; started from Settings the menu shows the report's wait screen, which draws 4 a second, so this is not the bare idle menu)")

    r.step("the periodic jobs")
    jobs, total = [], 0.0
    with tempfile.TemporaryDirectory(prefix="r3i6nos-power.") as tmp:
        for name, cmd, env, per_hour in (
            ("battery sample tick", [BATTERY_CMD, "sample", "tick", "power-report"], {"R3I6NOS_BATTERY_DIR": tmp}, 4),   # loveos-session: every 900 s
            ("bootstate", [BOOTSTATE_CMD], {"R3I6NOS_BOOTSTATE": os.path.join(tmp, "boot-state")}, 4),   # the timer: every 15 min
        ):
            c = job_cost(cmd, env)
            if c is None or not Path(cmd[0]).exists():
                r.line("SKIP", f"job {name}", f"{cmd[0]} would not run here")
                continue
            share = c[0] * per_hour / 3600 * 100
            total += share
            r.line("INFO", f"job {name}", f"{c[0] * 1000:.0f} ms CPU, {c[1] * 1000:.0f} ms wall a run, {per_hour} runs an hour = {share:.4f}% of a core")
            jobs.append(name)
    if jobs:
        r.line("PASS" if total <= GOAL_JOBS_CPU else "FAIL", "jobs cpu", f"{total:.4f}% of a core averaged, for {', '.join(jobs)} (goal at most {GOAL_JOBS_CPU}%; bootstate run as this user, so systemctl fails fast and its cost here is a lower bound)")
    r.line("SKIP", "job clock save", "hourly, root, writes the card: not run here; one small file an hour")

    r.step("the hot-plug daemon stopped, then started again")
    if not discharging:
        r.line("SKIP", "hotplug draw", "needs the battery discharging with current_now (see above)")
    elif h is None:
        r.line("SKIP", "hotplug draw", "the daemon is not running")
    elif os.geteuid() != 0 and not ENV("R3I6NOS_POWER_AB"):
        r.line("SKIP", "hotplug draw", "stopping a root service needs root: run `sudo r3i6nos-report` over SSH for the stop-and-compare")
    else:
        pid = pids["hotplug"]
        try:
            os.kill(pid, signal.SIGSTOP)
            try:
                off = measure(POWER_S, {}, b)
            finally:
                os.kill(pid, signal.SIGCONT)        # always started again, whatever happened
        except OSError as e:
            r.line("SKIP", "hotplug draw", f"could not stop the daemon: {e}")
            off = None
        if off and off["draws"]:
            on2 = measure(POWER_S, {}, b)
            a, c, d = mean(base["draws"]), mean(off["draws"]), mean(on2["draws"])
            noise = abs(a - d)
            cost_mw = (a + d) / 2 - c
            r.line("INFO", "draw running / stopped / running", f"{a:.0f} / {c:.0f} / {d:.0f} mW (the two running windows differ by {noise:.0f} mW: that is the noise)")
            over = cost_mw - noise
            r.line("PASS" if over <= GOAL_DAEMON_MW else "FAIL", "hotplug draw",
                   f"about {cost_mw:.0f} mW ({cost_mw / ((a + d) / 2) * 100:.1f}% of the idle draw), {max(over, 0):.0f} mW beyond the noise (goal at most {GOAL_DAEMON_MW:.0f} mW)")
    r.line("INFO", "reading this", "one window each, on one battery: a short test. Repeat on charge levels 100%, 50%, 20% and on a warm unit before trusting a small number")


# ---- usb gadget and usb ethernet (ROADMAP section 28, docs/SCREEN-MIRROR.md) ----
# The screen mirror needs a wired link to a computer. Two ways, and this answers both without root and without changing anything: the unit as a
# network card on the computer (a USB *gadget*: a device-mode controller, configfs, an ethernet function), or the unit hosting a USB Ethernet
# adapter (a host driver). Each fact is PASS (the running kernel has it), FAIL (the kernel config says it does not: only a config proves an absence,
# because a symbol name or a module file can be missing while the code is built in) or SKIP (nothing readable says; the line names what to try).
GADGET_FUNCS = (   # (name, kernel config, module, a symbol the code has, who can use it: from memory, not tried)
    ("ECM", "USB_CONFIGFS_ECM", "usb_f_ecm", "ecm_alloc_inst", "macOS and Linux"),
    ("NCM", "USB_CONFIGFS_NCM", "usb_f_ncm", "ncm_alloc_inst", "macOS, Linux and Windows 11"),
    ("RNDIS", "USB_CONFIGFS_RNDIS", "usb_f_rndis", "rndis_alloc_inst", "Windows and Linux"),
    ("EEM", "USB_CONFIGFS_EEM", "usb_f_eem", "eem_alloc_inst", "Linux"),
)
HOST_NET = (       # (module = USB driver name, kernel config, what it drives)
    ("usbnet", "USB_USBNET", "the base every adapter driver below needs"),
    ("asix", "USB_NET_AX8817X", "ASIX AX88772 and AX88172, the common 10/100 adapter"),
    ("ax88179_178a", "USB_NET_AX88179_178A", "ASIX AX88179 and AX88178A, gigabit"),
    ("r8152", "USB_RTL8152", "Realtek RTL8152 and RTL8153, many 100 Mb and gigabit dongles"),
    ("cdc_ether", "USB_NET_CDCETHER", "generic CDC ethernet, some adapters and phones' USB tethering"),
    ("cdc_ncm", "USB_NET_CDC_NCM", "CDC NCM adapters and tethering"),
    ("smsc95xx", "USB_NET_SMSC95XX", "SMSC LAN9500, Raspberry Pi style"),
    ("rndis_host", "USB_NET_RNDIS_HOST", "Android USB tethering"),
    ("dm9601", "USB_NET_DM9601", "Davicom DM9601, cheap 10/100"),
)
HOST_ADAPTERS = ("asix", "ax88179_178a", "r8152", "cdc_ether", "cdc_ncm", "smsc95xx", "rndis_host", "dm9601")
NET_CLASSES = ("02", "0a", "e0", "ff")     # a USB interface that may be a network adapter: CDC comm and data, wireless controller, vendor specific


def norm(name):
    return name.replace("-", "_")


def readlink_name(path):
    try:
        return os.path.basename(os.readlink(path))
    except OSError:
        return None


class Kernel:
    """What the running kernel can be asked: its config (when it ships one), its symbols, its module files and loaded modules."""

    def __init__(self):
        self.release = read(PROC / "sys/kernel/osrelease") or ""
        self.cfg, self.cfg_src = None, None
        for path in (PROC / "config.gz", SETUP_BOOT / f"config-{self.release}", SETUP_BOOT / "config", MODULES / self.release / "config",
                     MODULES / self.release / "build/.config"):
            try:
                raw = gzip.open(path, "rt", errors="replace").read() if path.suffix == ".gz" else path.read_text(errors="replace")
            except (OSError, EOFError, gzip.BadGzipFile):
                continue
            cfg = {}
            for ln in raw.splitlines():
                m = re.match(r"CONFIG_(\w+)=(.*)$", ln)
                if m:
                    cfg[m.group(1)] = m.group(2).strip('"')
            if cfg:
                self.cfg, self.cfg_src = cfg, str(path)
                break
        text = read(PROC / "kallsyms")
        self.syms = {p[2] for p in (ln.split() for ln in text.splitlines()) if len(p) >= 3} if text else None
        self.loaded = {norm(ln.split()[0]) for ln in (read(PROC / "modules") or "").splitlines() if ln.split()}
        base = MODULES / self.release
        self.files, self.builtin = set(), set()
        if self.release and base.is_dir():
            for _, _, names in os.walk(base):
                for f in names:
                    m = re.match(r"(.+?)\.ko(\.\w+)?$", f)
                    if m:
                        self.files.add(norm(m.group(1)))
            for ln in (read(base / "modules.builtin") or "").splitlines():
                m = re.match(r"(?:.*/)?(.+?)\.ko$", ln.strip())
                if m:
                    self.builtin.add(norm(m.group(1)))

    def probe(self, opts=(), mods=(), syms=(), usb_driver=None):
        """(True, how) when the running kernel has it; (False, why) when its config says it does not; (None, why) when nothing readable says."""
        how, only_m = [], []
        for m in mods:
            n = norm(m)
            if n in self.loaded:
                how.append(f"module {m} loaded")
            elif n in self.builtin:
                how.append(f"{m} built in")
            elif n in self.files:
                how.append(f"module file {m}.ko")
        for o in opts:
            v = (self.cfg or {}).get(o)
            if v == "y":
                how.append(f"CONFIG_{o}=y")
            elif v == "m":
                (how if how else only_m).append(f"CONFIG_{o}=m")
        if usb_driver and (SYS / "bus/usb/drivers" / usb_driver).is_dir():
            how.append("registered USB driver")
        found = [x for x in syms if self.syms and x in self.syms]
        if found:
            how.append(f"kernel symbol {found[0]}")
        if how:
            return True, "; ".join(how)
        if only_m:
            return False, f"{only_m[0]} but no such module file under {MODULES}/{self.release or '?'}"
        if self.cfg is not None:
            return False, "; ".join(f"CONFIG_{o} is {self.cfg.get(o, 'not set')}" for o in opts) or "not in the kernel config"
        return None, "nothing readable says: no kernel config, and no module file, loaded driver or symbol by that name"


def state_status(state):
    return {True: "PASS", False: "FAIL", None: "SKIP"}[state]


def usb_nodes():
    """The device tree's USB controller nodes that have a role (dwc2 / dwc_otg, or a dr_mode): (name, compatible, dr_mode, status)."""
    out = []
    for dirpath, dirs, files in os.walk(PROC / "device-tree"):
        dirs.sort()
        if "compatible" not in files and "dr_mode" not in files:
            continue
        d = Path(dirpath)
        try:
            comp = [c.decode("ascii", "replace") for c in (d / "compatible").read_bytes().split(b"\0") if c]
        except OSError:
            comp = []
        mode = read(d / "dr_mode")
        if mode or any("dwc" in c or "otg" in c for c in comp):
            out.append((d.name, comp, mode, read(d / "status") or "okay"))
        if len(out) >= 8:
            break
    return out


def usb_devices():
    """Every USB device but the root hubs, with each interface's class and bound driver; None when there is no USB bus in /sys."""
    base = SYS / "bus/usb/devices"
    if not base.is_dir():
        return None
    out = []
    for d in sorted(base.iterdir()):
        if ":" in d.name or d.name.startswith("usb"):
            continue
        ifaces = [(read(i / "bInterfaceClass"), readlink_name(i / "driver")) for i in sorted(base.glob(d.name + ":*"))]
        out.append({"name": d.name, "vid": read(d / "idVendor") or "????", "pid": read(d / "idProduct") or "????", "product": read(d / "product") or "?",
                    "mfr": read(d / "manufacturer") or "", "speed": read(d / "speed") or "?", "cls": read(d / "bDeviceClass"), "ifaces": ifaces})
    return out


def net_ifaces():
    """Every network interface but lo: (name, kind gadget|usb|other, wifi, driver, operstate, carrier, speed Mb/s, mac)."""
    base = SYS / "class/net"
    out = []
    if not base.is_dir():
        return out
    for d in sorted(base.iterdir()):
        if d.name == "lo":
            continue
        dev = d / "device"
        real = os.path.realpath(dev) if dev.exists() else ""
        parts = Path(real).parts
        kind = "gadget" if "gadget" in parts else "usb" if any(re.fullmatch(r"usb\d+", p) for p in parts) else "other"
        wifi = (d / "wireless").is_dir() or (d / "phy80211").exists()
        out.append((d.name, kind, wifi, readlink_name(dev / "driver"), read(d / "operstate") or "?", read(d / "carrier"), read(d / "speed"), read(d / "address") or "?"))
    return out


def usb_gadget(r):
    """== usb gadget ==: can the OTG port be a network card for a computer? Returns "ready", "no" or "unknown" for the verdict."""
    r.step("the USB gadget (device mode)")
    r.section("usb gadget")
    k = Kernel()
    r.line("INFO", "kernel", k.release or "unknown")
    if k.cfg is None:
        r.line("SKIP", "kernel config", "none readable (no /proc/config.gz, no config on the boot partition or under /lib/modules): what the kernel lacks cannot be proved, only what it has")
    else:
        r.line("INFO", "kernel config", f"{k.cfg_src}, {len(k.cfg)} options")
    r.line("INFO" if k.syms is not None else "SKIP", "kernel symbols", "readable" if k.syms is not None else "/proc/kallsyms is not readable")
    r.line("INFO", "module files", f"{len(k.files)} under {MODULES}/{k.release or '?'}, {len(k.builtin)} built in by modules.builtin")

    nodes = usb_nodes()
    if not nodes:
        r.line("SKIP", "usb controller", "no dwc2 / dwc_otg node or dr_mode in /proc/device-tree")
    for name, comp, mode, status in nodes:
        r.line("INFO", f"usb controller {name}", f"{', '.join(comp) or 'no compatible'}; dr_mode {mode or 'not set (the driver default)'}; status {status}")
    drivers = sorted(p.name for p in (SYS / "bus/platform/drivers").glob("*") if re.search(r"dwc|otg|udc|usb", p.name)) if (SYS / "bus/platform/drivers").is_dir() else []
    r.line("INFO" if drivers else "SKIP", "usb platform drivers", ", ".join(drivers) or "none listed in /sys/bus/platform/drivers")
    host_only = bool(nodes) and all(m == "host" for _, _c, m, _s in nodes)   # every role-bearing controller is pinned to host

    udcs = sorted(p.name for p in (SYS / "class/udc").glob("*")) if (SYS / "class/udc").is_dir() else []
    for u in udcs:
        base = SYS / "class/udc" / u
        r.line("INFO", f"udc {u}", f"state {read(base / 'state') or '?'}; speed {read(base / 'current_speed') or '?'} (max {read(base / 'maximum_speed') or '?'}); otg {read(base / 'is_otg') or '?'}")
    for e in sorted((SYS / "class/extcon").glob("*")) if (SYS / "class/extcon").is_dir() else []:
        r.line("INFO", f"extcon {read(e / 'name') or e.name}", (read(e / "state") or "?").replace("\n", " "))
    for s in sorted((SYS / "class/power_supply").glob("*")) if (SYS / "class/power_supply").is_dir() else []:
        if read(s / "type") in ("USB", "Mains") or "usb" in s.name.lower() or s.name.lower().startswith("ac"):
            r.line("INFO", f"supply {s.name}", f"type {read(s / 'type') or '?'}; online {read(s / 'online') or '?'}")

    # 1. a device-mode controller: only a UDC in /sys/class/udc proves it; a host-only device tree or a config without USB_GADGET proves its absence
    if udcs:
        udc = (True, "registered: " + ", ".join(udcs))
    elif nodes and host_only:
        udc = (False, "the device tree sets the controller to dr_mode host: device mode is off (a device tree change, from the user's own card, rule 2)")
    else:
        g = k.probe(("USB_GADGET",), (), ("usb_add_gadget_udc", "usb_gadget_probe_driver"))
        udc = (g[0], g[1]) if g[0] is False else (None, "no UDC is listed in /sys/class/udc" + ("; the gadget core is in the kernel, so the port may only register one in device mode: plug the unit into a computer and run this report again" if g[0] else "; " + g[1]))
    r.line(state_status(udc[0]), "device-mode controller", udc[1])

    # 2. configfs and the composite framework
    configfs = "configfs" in (read(PROC / "filesystems") or "")
    if configfs:
        cfs = (True, "configfs is in /proc/filesystems")
    else:   # a module is not in /proc/filesystems until it loads, so only the config can prove it missing
        cfs = k.probe(("CONFIGFS_FS",), ("configfs",), ("configfs_register_subsystem",))
    r.line(state_status(cfs[0]), "configfs", cfs[1])
    mounted = (SYS / "kernel/config").is_dir() and any((SYS / "kernel/config").iterdir())
    r.line("INFO", "configfs mounted", "yes at /sys/kernel/config" if mounted else "no (a root helper would mount it)")
    gdir = SYS / "kernel/config/usb_gadget"
    r.line("INFO", "gadgets set up now", ", ".join(sorted(p.name for p in gdir.iterdir())) or "none" if gdir.is_dir() else "none (no usb_gadget in configfs)")
    comp = k.probe(("USB_LIBCOMPOSITE",), ("libcomposite",), ("usb_composite_probe",))
    if gdir.is_dir():
        comp = (True, "usb_gadget is in configfs")
    r.line(state_status(comp[0]), "composite gadget core", comp[1])
    ucfg = k.probe(("USB_CONFIGFS",))
    if gdir.is_dir():
        ucfg = (True, "usb_gadget is in configfs")
    r.line(state_status(ucfg[0]), "USB gadget by configfs", ucfg[1])

    # 3. an ethernet function a computer can use
    funcs = []
    for name, opt, mod, sym, who in GADGET_FUNCS:
        st = k.probe((opt,), (mod,), (sym,))
        funcs.append((name, st, who))
        r.line(state_status(st[0]), f"function {name}", f"{st[1]} (works with {who}, from memory)" if st[0] else st[1])
    geth = k.probe(("USB_ETH",), ("g_ether",))
    r.line("INFO" if geth[0] else state_status(geth[0]), "legacy g_ether", geth[1])
    uvc = k.probe(("USB_CONFIGFS_F_UVC",), ("usb_f_uvc",))
    r.line("INFO", "function UVC", f"{'present' if uvc[0] else 'not found'}: {uvc[1]} (the unit as a camera, an alternative link for pictures, ROADMAP section 24)")
    have = [n for n, st, _ in funcs if st[0]] + (["g_ether"] if geth[0] else [])
    if have:
        fn = (True, ", ".join(have))
    elif all(st[0] is False for _, st, _ in funcs) and geth[0] is False:
        fn = (False, "no ethernet function (ECM, NCM, RNDIS, EEM or g_ether) is in the kernel config")
    else:
        fn = (None, "no ethernet function found by name, and no config to prove they are missing")

    pieces = (("device-mode controller", udc), ("configfs", cfs), ("composite core", comp), ("USB gadget by configfs", ucfg), ("an ethernet function", fn))
    missing = [n for n, st in pieces if st[0] is False]
    unknown = [n for n, st in pieces if st[0] is None]
    if missing:
        r.line("FAIL", "gadget ethernet", f"cannot work as the kernel is: missing {', '.join(missing)}" + (f"; unknown {', '.join(unknown)}" if unknown else ""))
        return "no"
    if unknown:
        r.line("SKIP", "gadget ethernet", f"not decided: nothing says whether {', '.join(unknown)} is there. Next: run this report with the cable to a computer, and over SSH look at /sys/class/udc, `zcat /proc/config.gz` and `modinfo usb_f_ecm`")
        return "unknown"
    r.line("PASS", "gadget ethernet", f"ready to try: a UDC, configfs and {', '.join(have)}. Next: a root helper makes an ECM or NCM gadget and the report checks a computer sees it")
    return "ready"


def usb_ethernet(r, gadget):
    """== usb ethernet ==: can the OTG port host a wired adapter, what is plugged in now, and the verdict for the mirror's link."""
    r.step("the USB Ethernet adapters (host mode)")
    r.section("usb ethernet")
    k = Kernel()
    states = {}
    for mod, opt, what in HOST_NET:
        st = k.probe((opt,), (mod,), (), usb_driver=mod)
        states[mod] = st[0]
        r.line("PASS" if st[0] else "INFO", f"host driver {mod}", f"{st[1]}; {what}" if st[0] else f"{st[1]} ({what})")
    ok = [m for m in HOST_ADAPTERS if states.get(m)]
    if states.get("usbnet") is False or all(states.get(m) is False for m in HOST_ADAPTERS):
        r.line("FAIL", "usb ethernet adapter", "no adapter driver in the kernel config: a wired adapter cannot work as the kernel is")
        adapter = "no"
    elif ok:
        r.line("PASS", "usb ethernet adapter", f"drivers present: {', '.join(ok)}")
        adapter = "ready"
    else:
        r.line("SKIP", "usb ethernet adapter", "no driver found by name and no config to prove none: plug an adapter in and run this report again")
        adapter = "unknown"

    devs = usb_devices()
    if devs is None:
        r.line("SKIP", "usb devices", "no USB bus in /sys/bus/usb/devices")
    elif not devs:
        r.line("SKIP", "usb devices", "none plugged in: plug the adapter in (or the cable to a computer) and run this report again")
    for d in devs or []:
        drvs = sorted({drv for _, drv in d["ifaces"] if drv}) or ["none"]
        name = f"{d['mfr']} {d['product']}".strip()
        netlike = [c for c, drv in d["ifaces"] if c in NET_CLASSES and not drv]
        line = f"{d['vid']}:{d['pid']} {name}; {d['speed']} Mb/s; driver {', '.join(drvs)}"
        if netlike:
            r.line("FAIL", f"usb device {d['name']}", line + f"; interface class {netlike[0]} has no driver: if this is an adapter, the kernel has none for it (find its chip and driver in the table above)")
        else:
            r.line("INFO", f"usb device {d['name']}", line)

    wired_up = False
    nets = net_ifaces()
    if not nets:
        r.line("SKIP", "network interfaces", "none but lo")
    for name, kind, wifi, drv, oper, carrier, speed, mac in nets:
        sp = f"{speed} Mb/s" if speed and speed.lstrip("-").isdigit() and int(speed) > 0 else "speed unknown"
        what = ("wifi" if wifi else "wired") + {"gadget": " (this unit as a USB gadget)", "usb": " (a USB adapter)", "other": ""}[kind]
        addr = (run(["ip", "-4", "-o", "addr", "show", name]) or "").split()
        ip = addr[addr.index("inet") + 1] if "inet" in addr else "no IPv4 address"
        r.line("INFO", f"network {name}", f"{what}; driver {drv or 'none'}; {oper}; carrier {carrier or '?'}; {sp}; mac {mac}; {ip}")
        if not wifi and kind in ("gadget", "usb") and carrier == "1":
            r.line("PASS", f"wired link {name}", f"up ({what}, {sp}): the mirror can use this link")
            wired_up = True
        elif not wifi and kind == "gadget":
            r.line("INFO", f"wired link {name}", "the gadget exists but nothing is connected to it (no carrier): plug the cable into a computer")
    if not wired_up and not any(not n[2] and n[1] in ("gadget", "usb") for n in nets):
        r.line("SKIP", "wired link", "no wired USB interface exists now: plug in an adapter, or (when the gadget helper exists) start the gadget")
    r.line("INFO", "tools", ", ".join(f"{t} {'yes' if shutil.which(t) else 'no'}" for t in ("ip", "modprobe", "udhcpd", "dnsmasq", "busybox", "python3")))

    if gadget == "ready":
        how = "use the gadget: one cable to the computer, which also powers the unit; no adapter. Offer ECM first (macOS and Linux need no driver), RNDIS for Windows"
    elif adapter == "ready":
        how = "use a USB Ethernet adapter on the OTG port (host mode): it draws from the battery, and the one port cannot also charge; measure its draw with the power section"
    elif gadget == "no" and adapter == "no":
        how = "neither wire works as the kernel and device tree are: a Wi-Fi dongle works (tested by the maintainer 2026-11-13) as a person-chosen link, or build the missing pieces out of tree"
    else:
        how = "undecided: send this report from three runs (nothing plugged in, an Ethernet adapter, the cable to a computer) and read the SKIP lines"
    r.line("INFO", "wired mirror verdict", how)


def usb_sections(r):
    """Both USB sections; a crash in the gadget checks still lets the adapter checks run."""
    try:
        gadget = usb_gadget(r)
    except Exception as e:
        r.line("FAIL", "usb gadget", f"a check crashed: {e}")
        gadget = "unknown"
    usb_ethernet(r, gadget)


def demo_recording():
    """True while a Rec demo holds /run/loveos/demo/lock with a live pid (docs/DEMO-RECORDINGS.md: the unit's whole power is its)."""
    try:
        pid = int(Path(os.environ.get("R3I6NOS_RUN", "/run/loveos") + "/demo/lock").read_text().split()[0])
        os.kill(pid, 0)
    except PermissionError:
        return True
    except (OSError, ValueError, IndexError):
        return False
    return True


def main(argv):
    quiet = "--quiet" in argv
    if demo_recording():
        print("r3i6nos-report: a Rec demo is recording; the unit's whole power is its until it ends", file=sys.stderr)
        return 75
    how = "Settings > Device reports" if "--from-settings" in argv else "r3i6nos-report"
    rel = keyvals(ETC / "r3i6nos-release")
    cards = keyvals(STATE)
    try:
        folder, card = where(cards)
        r = Report(folder, how, rel.get("VERSION", "?"), card, quiet)
        r.steps = 11 + 2 * len(mounted_cards(cards))
    except OSError as e:
        print(f"r3i6nos-report: cannot write the report: {e}", file=sys.stderr)
        return 1
    for part in (lambda: (system(r, rel), setup_section(r)), lambda: boot(r), lambda: sound(r), lambda: clock(r), lambda: storage(r, cards), lambda: usb_sections(r), lambda: power_section(r)):
        try:
            part()
        except Exception as e:  # a broken check is a line in the report, never a missing report
            r.line("FAIL", "report", f"a check crashed: {e}")
    r.close()
    r.step("done")
    if not quiet:
        print(f"written: {r.path}")
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
