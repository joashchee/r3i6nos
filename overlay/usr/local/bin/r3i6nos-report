#!/usr/bin/env python3
"""r3i6nos-report - the device report of r3i6nos itself (docs/DEVICE-REPORTS.md, docs/STORAGE.md).

    r3i6nos-report [--from-settings] [--quiet]

Checks and measures what only the unit can answer about the system, and writes r3i6nos/r36s-report.txt on the data card when one is
mounted (so the boot card can stay in), else on the system card, for Claude to read in the r3i6nos repo. Settings > Device reports
starts it (it is linked into /opt/loveos/bin as a report); over SSH, run `r3i6nos-report`. It runs as loveos and needs no root.

Sections: system (the build, kernel, CPU, memory), setup (whether r3i6nos-setup made this card, docs/TWO-SLOT-SETUP.md), boot (units that failed, how long boot took), sound (the RK817's Playback
Path, the headphone jack, the volume keys and the mixer, from r3i6nos-sound), clock (r3i6nos-clock status), storage (every mmc disk and slot, what
r3i6nos-cards mounted, the kernel's filesystems, loop devices, and on each mounted card a write/rename/read/delete check and its speed),
power (what the background work costs the battery: the hot-plug daemon, the menu, the periodic jobs; the idle draw in mW; docs/POWER.md).

Standard library only. Overrides, for tests: R3I6NOS_ETC (/etc), R3I6NOS_PROC (/proc), R3I6NOS_SYS (/sys), R3I6NOS_DEV (/dev),
R3I6NOS_CARDS_STATE (/run/r3i6nos/cards), R3I6NOS_REPORT_DIR (the folder to write in), R3I6NOS_REPORT_MB (16: the speed test's size),
R3I6NOS_SETUP_VAR, R3I6NOS_SETUP_RUN, R3I6NOS_SETUP_BOOT (where r3i6nos-setup leaves its record, state and report),
R3I6NOS_SOUND (r3i6nos-sound), R3I6NOS_HOTPLUG (r3i6nos-hotplug),
R3I6NOS_CLOCK (r3i6nos-clock), and for the power section (docs/POWER.md): R3I6NOS_REPORT_POWER_S (30: seconds per measuring window),
R3I6NOS_BATTERY (r3i6nos-battery), R3I6NOS_BOOTSTATE_CMD (r3i6nos-bootstate), R3I6NOS_MENU_MATCH (/opt/loveos/menu: how the menu's process
is told), R3I6NOS_POWER_AB (1: do the stop-and-compare even when not root, tests).
"""
import os
import re
import resource
import signal
import subprocess
import sys
import tempfile
import time
from pathlib import Path

APP = "r3i6nos"          # read by the menu's Settings > Device reports (menu/reports.lua) for the entry's name
PACKAGE = "r3i6nos"
ENV = os.environ.get
ETC = Path(ENV("R3I6NOS_ETC", "/etc"))
PROC = Path(ENV("R3I6NOS_PROC", "/proc"))
SYS = Path(ENV("R3I6NOS_SYS", "/sys"))
DEV = Path(ENV("R3I6NOS_DEV", "/dev"))
STATE = Path(ENV("R3I6NOS_CARDS_STATE", "/run/r3i6nos/cards"))
MB = int(ENV("R3I6NOS_REPORT_MB", "16"))
REPORT_DIR = ENV("R3I6NOS_REPORT_DIR")
SOUND = ENV("R3I6NOS_SOUND", "/usr/local/bin/r3i6nos-sound")
HOTPLUG = ENV("R3I6NOS_HOTPLUG", "/usr/local/bin/r3i6nos-hotplug")
CLOCK = ENV("R3I6NOS_CLOCK", "/usr/local/bin/r3i6nos-clock")
BOOTSTATE = Path(ENV("R3I6NOS_BOOTSTATE", "/run/r3i6nos/boot-state"))   # r3i6nos-bootstate (root) writes it: systemctl answers only root
SETUP_VAR = Path(ENV("R3I6NOS_SETUP_VAR", "/var/lib/r3i6nos"))        # r3i6nos-setup's record (docs/TWO-SLOT-SETUP.md)
SETUP_RUN = Path(ENV("R3I6NOS_SETUP_RUN", "/run/r3i6nos"))
SETUP_BOOT = Path(ENV("R3I6NOS_SETUP_BOOT", "/boot"))
PROGRESS = ENV("R3I6NOS_REPORT_PROGRESS")   # set by the menu (menu/reports.lua): where to say how far it has got
POWER_S = float(ENV("R3I6NOS_REPORT_POWER_S", "30"))
BATTERY_CMD = ENV("R3I6NOS_BATTERY", "/usr/local/bin/r3i6nos-battery")
BOOTSTATE_CMD = ENV("R3I6NOS_BOOTSTATE_CMD", "/usr/local/bin/r3i6nos-bootstate")
MENU_MATCH = ENV("R3I6NOS_MENU_MATCH", "/opt/loveos/menu")
# the goals the power section checks against (docs/POWER.md): a goal missed is a FAIL line, not a silent number
GOAL_DAEMON_CPU = 1.0        # % of one core, the hot-plug daemon
GOAL_DAEMON_WAKEUPS = 4.0    # context switches a second, the hot-plug daemon (its poll is once a second)
GOAL_JOBS_CPU = 0.05         # % of one core, the periodic jobs together, averaged over an hour
GOAL_DAEMON_MW = 20.0        # mW the daemon may cost beyond the measuring noise
WANT_FS = ("exfat", "vfat", "ext4", "squashfs")


def read(path):
    try:
        return Path(path).read_text(errors="replace").replace("\0", "").strip()
    except OSError:
        return None


def keyvals(path):
    out = {}
    for line in (read(path) or "").splitlines():
        k, sep, v = line.partition("=")
        if sep:
            out[k.strip()] = v.strip()
    return out


class Report:
    def __init__(self, folder, how, version, card, quiet=False):
        self.quiet = quiet
        self.counts = {"PASS": 0, "FAIL": 0, "INFO": 0, "SKIP": 0}
        os.makedirs(folder, exist_ok=True)
        self.path = os.path.join(folder, "r36s-report.txt")
        self.tmp = self.path + ".tmp"
        self.f = open(self.tmp, "w", encoding="ascii", errors="replace", newline="\n")
        self.done_steps, self.steps = 0, 1
        self.raw("# r3i6nos device report\n"
                 f"app: {APP} {version} ({PACKAGE})\n"
                 f"made: {time.strftime('%Y-%m-%d %H:%M:%S')}\n"
                 f"how: {how}\n"
                 f"for: Claude. Copy r3i6nos/r36s-report.txt from the {card} to a computer and give it to Claude in the r3i6nos repo.\n")

    def step(self, doing):
        """Say what is being checked now, for the menu's progress bar (docs/DEVICE-REPORTS.md, "Progress"). Never fails the report."""
        self.done_steps += 1
        if not PROGRESS:
            return
        try:
            tmp = PROGRESS + ".tmp"
            with open(tmp, "w") as f:
                f.write(f"step={min(self.done_steps, self.steps)}\nsteps={self.steps}\ndoing={' '.join(doing.split())}\nfile={self.path}\n")
            os.replace(tmp, PROGRESS)
        except OSError:
            pass

    def raw(self, text):
        self.f.write(text)
        if not self.quiet:
            sys.stdout.write(text)
            sys.stdout.flush()

    def line(self, status, key, value):
        key = " ".join(str(key).replace(":", " ").split())
        value = " ".join(str(value).split())
        self.counts[status] += 1
        self.raw(f"{status} {key}: {value}\n")

    def section(self, name):
        self.raw(f"\n== {name} ==\n")

    def close(self):
        c = self.counts
        self.section("summary")
        self.raw(f"PASS {c['PASS']}  FAIL {c['FAIL']}  INFO {c['INFO']}  SKIP {c['SKIP']}\nend\n")
        self.f.flush()
        os.fsync(self.f.fileno())
        self.f.close()
        os.replace(self.tmp, self.path)


def run(cmd, timeout=10):
    """stdout, or None when it could not run or failed."""
    code, out, _ = run_full(cmd, timeout)
    return out if code == 0 else None


def run_full(cmd, timeout=10):
    """(exit status or None, stdout, the first line of stderr): for checks that should say why they failed."""
    try:
        r = subprocess.run(cmd, capture_output=True, text=True, timeout=timeout)
    except (OSError, subprocess.SubprocessError) as e:
        return None, "", str(e)
    err = (r.stderr or "").strip().splitlines()
    return r.returncode, r.stdout, err[0] if err else ""


def gb(n):
    return f"{n / 1e9:.1f} GB"


# ---- sections -------------------------------------------------------------------------------------------------------------------

def system(r, rel):
    r.step("the build and the system")
    r.section("system")
    if rel:
        r.line("INFO", "build", f"r3i6nos {rel.get('VERSION', '?')}, commit {rel.get('COMMIT', '?')[:10]} ({rel.get('COMMIT_DATE', '?')}), "
                                f"built {rel.get('BUILT', '?')} by {rel.get('BUILT_BY', '?')}" + (", modified" if rel.get("MODIFIED") == "1" else ""))
    else:
        r.line("FAIL", "build", "no /etc/r3i6nos-release")
    u = os.uname()
    r.line("INFO", "kernel", f"{u.sysname} {u.release} {u.machine}")
    model = read(PROC / "device-tree" / "model")
    if model:
        r.line("INFO", "board", model)
    cpus = sum(1 for ln in (read(PROC / "cpuinfo") or "").splitlines() if ln.startswith("processor"))
    khz = read(SYS / "devices/system/cpu/cpu0/cpufreq/cpuinfo_max_freq")
    r.line("INFO", "cpu", f"{cpus} CPUs" + (f", {int(khz) // 1000} MHz max" if khz and khz.isdigit() else ""))
    mem = {}
    for ln in (read(PROC / "meminfo") or "").splitlines():
        k, _, v = ln.partition(":")
        mem[k] = v.strip()
    if "MemTotal" in mem:
        r.line("INFO", "memory", f"total {mem['MemTotal']}, available {mem.get('MemAvailable', '?')}")


def setup_section(r):
    """How this card was made: by r3i6nos-setup (the unit prepared it from the original card), or not."""
    r.section("setup")
    done = keyvals(SETUP_VAR / "setup-done")
    state = keyvals(SETUP_RUN / "setup-state")
    if done:
        r.line("INFO", "made by r3i6nos-setup", f"{done.get('DATE', '?')}, build {done.get('VERSION', '?')}, original card id {done.get('SOURCE_ID', '?')}")
        r.line("INFO", "backup of the original", done.get("BACKUP", "none"))
    else:
        r.line("SKIP", "made by r3i6nos-setup", "no record: this card was not set up by the unit (or it was made with the host scripts)")
    if state:
        r.line("INFO", "this boot", state.get("mode", "?") + (f", {state['why']}" if state.get("why") else ""))
    text = read(SETUP_BOOT / "r3i6nos-setup-report.txt")
    if text:
        m = re.search(r"^PASS (\d+)  FAIL (\d+)", text, re.M)
        if m:
            r.line("PASS" if m.group(2) == "0" else "FAIL", "setup report on BOOT", f"{m.group(1)} PASS, {m.group(2)} FAIL (r3i6nos-setup-report.txt on the BOOT drive)")


def boot_state():
    """{key: value} from r3i6nos-bootstate's file, or {} when it is not there yet."""
    text = read(BOOTSTATE) or ""
    return {k: v for k, _, v in (ln.partition(": ") for ln in text.splitlines()) if k}


def state_line(r, state):
    # running: the boot finished and nothing failed; degraded: something failed; starting: jobs are still waiting
    r.line("PASS" if state == "running" else ("FAIL" if state in ("degraded", "maintenance") else "INFO"), "system state", state)


def jobs_line(r, waiting):
    r.line("PASS" if not waiting else "INFO", "jobs waiting", ", ".join(waiting[:8]) + (" ..." if len(waiting) > 8 else "") if waiting else "none")


def boot(r):
    r.step("how the boot went")
    r.section("boot")
    out = run(["systemctl", "list-units", "--failed", "--plain", "--no-legend", "--no-pager"])
    if out is None:
        # Not root, and no D-Bus in the image: systemctl cannot reach systemd. r3i6nos-bootstate (root, on a timer) writes what it says.
        st = boot_state()
        if not st:
            r.line("SKIP", "boot", f"systemctl answers only root here (no D-Bus), and {BOOTSTATE} is not written yet (a minute after boot)")
        else:
            r.line("INFO", "boot facts from", f"{BOOTSTATE}, written {st.get('written', '?')} (systemctl answers only root here)")
            failed = [] if st.get("failed units", "none") == "none" else st["failed units"].split()
            r.line("PASS" if not failed else "FAIL", "failed units", ", ".join(failed) if failed else "none")
            if st.get("system state"):
                state_line(r, st["system state"])
            jobs = st.get("jobs waiting", "none")
            jobs_line(r, [] if jobs == "none" else jobs.split())
            t = st.get("boot time", "")
            r.line("INFO" if t.startswith("Startup finished") else "SKIP", "boot time", t.replace("Startup finished in ", "") or "not written")
    else:
        failed = [ln.split()[0] for ln in out.splitlines() if ln.strip()]
        r.line("PASS" if not failed else "FAIL", "failed units", ", ".join(failed) if failed else "none")
        code, state, err = run_full(["systemctl", "is-system-running"])
        state = state.strip()
        if state:
            state_line(r, state)
        else:
            r.line("SKIP", "system state", err or "systemctl did not answer")
        code, jobs, err = run_full(["systemctl", "list-jobs", "--no-legend", "--no-pager", "--plain"])
        if code is not None and not err:
            jobs_line(r, [ln.split()[1] for ln in jobs.splitlines() if len(ln.split()) >= 2])
        code, t, err = run_full(["systemd-analyze", "time", "--no-pager"])
        if code == 0 and t.strip():
            r.line("INFO", "boot time", t.strip().splitlines()[0].replace("Startup finished in ", ""))
        else:
            r.line("SKIP", "boot time", f"systemd-analyze: {err}" if err else "systemd-analyze did not answer")
    up = read(PROC / "uptime")
    if up:
        r.line("INFO", "up for", f"{float(up.split()[0]) / 60:.1f} min")


def sound(r):
    """The speaker's state (r3i6nos-sound status): the RK817 codec is silent while its Playback Path is OFF."""
    r.step("the sound output")
    r.section("sound")
    out = run([SOUND, "status"])
    if out is None:
        r.line("SKIP", "sound", "r3i6nos-sound did not answer")
        return
    volume = False
    for ln in out.splitlines():
        key, _, val = ln.partition(": ")
        if key.endswith("playback path") and val != "none":
            cur = val.split(" ", 1)[0]
            r.line("PASS" if cur in ("SPK", "HP", "HP_NO_MIC", "SPK_HP") else "FAIL", key, val)
        elif key in ("mixer Volume", "mixer Boost"):
            volume = True
            r.line("PASS", key, val)
        elif key:
            r.line("INFO", key, val)
    if not volume:   # /etc/asound.conf's software volumes (docs/SOUND.md): without them the volume keys and the mixer do nothing
        r.line("FAIL", "mixer Volume", "missing: the software volumes were not made (is /etc/asound.conf in place?)")
    state = (run(["systemctl", "is-active", "r3i6nos-sound.service"]) or "").strip() or boot_state().get("unit r3i6nos-sound.service", "")
    r.line("INFO", "jack follower", state or "unknown")
    r.line("INFO", "heard", "not measured: listen for the menu's sounds (speaker), then with headphones in")
    # what is plugged in, and whether the toast's watcher runs (docs/HOTPLUG.md); the sysfs names it reads have never been read on the unit
    plugged = run([HOTPLUG, "status"])
    if plugged is None:
        r.line("SKIP", "hotplug", "r3i6nos-hotplug did not answer")
    else:
        for ln in plugged.splitlines():
            key, _, val = ln.partition(": ")
            r.line("INFO", "plugged " + key, val)
        hstate = (run(["systemctl", "is-active", "r3i6nos-hotplug.service"]) or "").strip() or boot_state().get("unit r3i6nos-hotplug.service", "")
        r.line("PASS" if hstate == "active" else "INFO", "hotplug watcher", hstate or "unknown")


def clock(r):
    """The clock (r3i6nos-clock status, docs/CLOCK.md): this report's own timestamps are only as good as it is."""
    r.step("the clock")
    r.section("clock")
    out = run([CLOCK, "status"])
    if out is None:
        r.line("SKIP", "clock", "r3i6nos-clock did not answer")
        return
    for ln in out.splitlines():
        key, _, val = ln.partition(": ")
        if key == "set by a person":
            r.line("PASS" if val != "no" else "FAIL", key, val if val != "no" else "no: set it in Settings > Date and time (the times here may be off)")
        elif key:
            r.line("INFO", key, val)


def disks():
    """[(name, bytes, removable)] for every mmc disk."""
    out = []
    try:
        names = sorted(p.name for p in (SYS / "block").iterdir())
    except OSError:
        return out
    for n in names:
        if re.fullmatch(r"mmcblk\d+", n):
            sectors = read(SYS / "block" / n / "size")
            out.append((n, int(sectors) * 512 if sectors and sectors.isdigit() else 0, read(SYS / "block" / n / "removable") == "1"))
    return out


def mounts():
    out = {}
    for line in (read(PROC / "mounts") or "").splitlines():
        p = line.split()
        if len(p) >= 4:
            out[p[1]] = (p[0], p[2], p[3])
    return out


def speed(r, label, folder):
    path = os.path.join(folder, ".r36s-report-speed")
    block = os.urandom(1 << 20)
    try:
        t0 = time.monotonic()
        fd = os.open(path, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o644)
        try:
            for _ in range(MB):
                os.write(fd, block)
            os.fsync(fd)
        finally:
            os.close(fd)
        w = time.monotonic() - t0
        fd = os.open(path, os.O_RDONLY)
        try:
            if hasattr(os, "posix_fadvise"):
                os.posix_fadvise(fd, 0, 0, os.POSIX_FADV_DONTNEED)  # read from the card, not from memory
            t0 = time.monotonic()
            while os.read(fd, 1 << 20):
                pass
            rd = time.monotonic() - t0
        finally:
            os.close(fd)
        r.line("INFO", f"{label} write speed", f"{MB / w:.1f} MB/s ({MB} MB, synced)")
        r.line("INFO", f"{label} read speed", f"{MB / rd:.1f} MB/s" if rd > 0 else "too fast to time")
    except OSError as e:
        r.line("FAIL", f"{label} speed", e)
    finally:
        try:
            os.remove(path)
        except OSError:
            pass


def card_check(r, label, folder):
    a, b = os.path.join(folder, ".r36s-report-test"), os.path.join(folder, ".r36s-report-test.tmp")
    try:
        os.makedirs(folder, exist_ok=True)
        with open(a, "w") as f:
            f.write("first\n")
        with open(b, "w") as f:
            f.write("second\n")
        os.replace(b, a)
        with open(a) as f:
            ok = f.read() == "second\n"
        os.remove(a)
        r.line("PASS" if ok else "FAIL", f"{label} write, rename over, read, delete", "ok" if ok else "read back different text")
    except OSError as e:
        r.line("FAIL", f"{label} write, rename over, read, delete", e)
    for p in (a, b):
        try:
            os.remove(p)
        except OSError:
            pass


def mounted_cards(cards):
    """The cards to check and time: (state key, label, mount point), only those mounted."""
    m = mounts()
    out = []
    for role in ("SYSTEM", "DATA"):
        at = cards.get(f"{role}_AT", "none")
        if at != "none" and at in m:
            out.append((role, "system card" if role == "SYSTEM" else "data card", at))
    return out


def storage(r, cards):
    r.step("the card slots and filesystems")
    r.section("storage")
    found = disks()
    boot_disk = cards.get("BOOT_DISK", "none")
    if not found:
        r.line("SKIP", "mmc disks", "none in /sys/block")
    for name, size, removable in found:
        role = "boot (system card)" if name == boot_disk else "other (data card?)"
        r.line("INFO", f"disk {name}", f"{gb(size)}, {role}" + (", removable" if removable else ""))
    if found:
        r.line("PASS" if len(found) >= 2 else "INFO", "cards in the slots", f"{len(found)}" + ("" if len(found) >= 2 else " (put a card in TF2 to test the data card)"))
    try:
        hosts = sorted(p.name for p in (SYS / "class" / "mmc_host").iterdir())
    except OSError:
        hosts = []
    if hosts:
        r.line("INFO", "mmc hosts", ", ".join(hosts))
    if not cards:
        r.line("FAIL", "r3i6nos-cards", f"no {STATE}: the cards service did not run")
    else:
        for role in ("SYSTEM", "DATA"):
            dev, fs, at = cards.get(f"{role}_DEV", "none"), cards.get(f"{role}_FS", "none"), cards.get(f"{role}_AT", "none")
            name = "system card" if role == "SYSTEM" else "data card"
            if dev == "none":
                r.line("INFO", name, "none found")
            elif at == "none":
                r.line("FAIL", name, f"{dev} ({fs}) found but not mounted")
            else:
                r.line("PASS", name, f"{dev} ({fs}) on {at}")
    have = set()
    for ln in (read(PROC / "filesystems") or "").splitlines():
        have.add(ln.split()[-1])
    if have:
        for fs in WANT_FS:
            r.line("PASS" if fs in have else ("FAIL" if fs == "squashfs" else "INFO"), f"kernel {fs}", "yes" if fs in have else "no")
    else:
        r.line("SKIP", "kernel filesystems", "no /proc/filesystems")
    loops = (DEV / "loop-control").exists() or (DEV / "loop0").exists()
    r.line("PASS" if loops else "FAIL", "loop devices", "yes" if loops else "no /dev/loop-control or /dev/loop0")
    m = mounts()
    for role, label, at in mounted_cards(cards):
        dev, fs, opts = m[at]
        try:
            st = os.statvfs(at)
            r.line("INFO", f"{label} space", f"{gb(st.f_bavail * st.f_frsize)} free of {gb(st.f_blocks * st.f_frsize)} ({fs}, {opts.split(',')[0]})")
        except OSError as e:
            r.line("FAIL", f"{label} space", e)
        folder = os.path.join(at, "r3i6nos")
        r.step(f"the {label}: write, rename, read, delete")
        card_check(r, label, folder)
        r.step(f"the {label}: speed ({MB} MB)")
        speed(r, label, folder)


def where(cards):
    """(folder, which card): the data card when one is mounted, so the boot card can stay in."""
    data, system_at = cards.get("DATA_AT", "none"), cards.get("SYSTEM_AT", "none")
    card = "data card" if data != "none" and data != system_at else "system card"
    if REPORT_DIR:
        return REPORT_DIR, card
    root = data if data != "none" else (system_at if system_at != "none" else "/roms")
    return os.path.join(root, "r3i6nos"), card


# ---- power: what the background work costs (docs/POWER.md) ------------------------------------------------------------------------

CLK = os.sysconf("SC_CLK_TCK") if hasattr(os, "sysconf") else 100


def find_pids(*needles):
    """Pids whose command line holds every needle (a name, an argument)."""
    out = []
    try:
        names = [p.name for p in PROC.iterdir() if p.name.isdigit()]
    except OSError:
        return out
    for n in names:
        cmd = (read(PROC / n / "cmdline") or "").replace("\0", " ")
        if cmd and all(x in cmd for x in needles) and n != str(os.getpid()):
            out.append(int(n))
    return sorted(out)


def proc_snap(pid):
    """CPU ticks, context switches and resident kB of one process, or None when it is gone."""
    stat = read(PROC / str(pid) / "stat")
    if not stat or ")" not in stat:
        return None
    rest = stat.rsplit(")", 1)[1].split()
    try:
        ticks = int(rest[11]) + int(rest[12])
    except (IndexError, ValueError):
        return None
    st = {k: v for k, _, v in (ln.partition(":") for ln in (read(PROC / str(pid) / "status") or "").splitlines())}
    num = lambda k: int((st.get(k) or "0").split()[0])
    return {"ticks": ticks, "ctx": num("voluntary_ctxt_switches") + num("nonvoluntary_ctxt_switches"), "rss": num("VmRSS"),
            "name": (st.get("Name") or str(pid)).strip()}


def sys_snap():
    """Total and idle CPU ticks, interrupts and context switches since boot, from /proc/stat."""
    out = {"total": 0, "idle": 0, "intr": 0, "ctxt": 0}
    for ln in (read(PROC / "stat") or "").splitlines():
        p = ln.split()
        if p and p[0] == "cpu":
            v = [int(x) for x in p[1:]]
            out["total"], out["idle"] = sum(v), v[3] + (v[4] if len(v) > 4 else 0)
        elif p and p[0] in ("intr", "ctxt") and len(p) > 1:
            out[p[0]] = int(p[1])
    return out


def all_snaps():
    out = {}
    try:
        names = [p.name for p in PROC.iterdir() if p.name.isdigit()]
    except OSError:
        return out
    for n in names:
        s = proc_snap(int(n))
        if s:
            out[int(n)] = s
    return out


def pct(before, after, wall):
    """CPU as % of one core between two snapshots of one process."""
    return max(0, after["ticks"] - before["ticks"]) / CLK / wall * 100 if wall > 0 else 0.0


def supply():
    base = SYS / "class/power_supply"
    try:
        names = sorted(p.name for p in base.iterdir())
    except OSError:
        return None
    for n in names:
        if (read(base / n / "type") or "").lower() == "battery":
            return base / n
    for n in names:
        if "bat" in n.lower() or n.lower().startswith("bms"):
            return base / n
    return None


def num(path):
    try:
        return int(read(path))
    except (TypeError, ValueError):
        return None


def draw_mw(b):
    """The battery's draw now in mW (current x voltage), or None when it does not report both."""
    i, v = num(b / "current_now"), num(b / "voltage_now")
    return abs(i) * v / 1e9 if i is not None and v else None


def measure(seconds, pids, b=None):
    """Watch for `seconds`: CPU and wakeups of `pids` (a name -> pid map), of the whole system and of every process, and the battery's draw once a second."""
    names = list(pids)
    s0, p0, a0, t0 = sys_snap(), {n: proc_snap(p) for n, p in pids.items()}, all_snaps(), time.monotonic()
    draws = []
    end = t0 + seconds
    while True:
        if b is not None and (d := draw_mw(b)) is not None:
            draws.append(d)
        left = end - time.monotonic()
        if left <= 0:
            break
        time.sleep(min(1.0, left))
    wall = max(time.monotonic() - t0, 1e-6)
    s1, a1 = sys_snap(), all_snaps()
    procs = {}
    for n in names:
        p1 = proc_snap(pids[n])
        if p0[n] and p1:
            procs[n] = {"cpu": pct(p0[n], p1, wall), "wake": max(0, p1["ctx"] - p0[n]["ctx"]) / wall, "rss": p1["rss"]}
    dt = s1["total"] - s0["total"]
    top = sorted(((pct(a0[p], a1[p], wall), a1[p]["name"], p) for p in a1 if p in a0), reverse=True)[:5]
    return {"wall": wall, "procs": procs, "draws": draws, "top": top,
            "busy": (100.0 * (dt - (s1["idle"] - s0["idle"])) / dt) if dt > 0 else None,
            "intr": (s1["intr"] - s0["intr"]) / wall, "ctxt": (s1["ctxt"] - s0["ctxt"]) / wall}


def mean(xs):
    return sum(xs) / len(xs) if xs else None


def job_cost(cmd, env, runs=3):
    """CPU seconds and wall seconds one run of a periodic job takes, or None when it could not run (it may be root's)."""
    cpu, wall, ok = 0.0, 0.0, 0
    for _ in range(runs):
        r0, t0 = resource.getrusage(resource.RUSAGE_CHILDREN), time.monotonic()
        try:
            subprocess.run(cmd, env=dict(os.environ, **env), capture_output=True, timeout=30)
        except (OSError, subprocess.SubprocessError):
            return None
        r1 = resource.getrusage(resource.RUSAGE_CHILDREN)
        cpu += (r1.ru_utime + r1.ru_stime) - (r0.ru_utime + r0.ru_stime)
        wall += time.monotonic() - t0
        ok += 1
    return cpu / ok, wall / ok


def power_section(r):
    r.section("power")
    b = supply()
    if b is None:
        r.line("SKIP", "battery", "no battery supply found, so no draw can be measured (the CPU and wake-up costs below still are)")
        status = None
    else:
        status = read(b / "status")
        r.line("INFO", "battery supply", f"{b.name}: {read(b / 'capacity') or '?'}%, {status or 'status not reported'}")
        i, v = num(b / "current_now"), num(b / "voltage_now")
        r.line("INFO" if i is not None else "SKIP", "current_now", f"{abs(i) / 1000:.0f} mA" + (f" at {v / 1e6:.2f} V" if v else "") if i is not None else "not reported: the draw cannot be measured here, only CPU time and wake-ups")
    discharging = b is not None and status == "Discharging" and draw_mw(b) is not None
    if b is not None and status != "Discharging":
        r.line("SKIP", "draw", f"the battery says {status or 'nothing'}, not Discharging: unplug the power and run again for the draw in mW")

    hp = find_pids("r3i6nos-hotplug", "start")
    menu = find_pids(MENU_MATCH)
    pids = {}
    if hp:
        pids["hotplug"] = hp[0]
    if menu:
        pids["menu"] = menu[0]

    r.step(f"the unit idle for {POWER_S:.0f} s: CPU, wake-ups, draw")
    base = measure(POWER_S, pids, b if discharging else None)
    r.line("INFO", "window", f"{base['wall']:.0f} s with the menu showing, nothing pressed")
    if base["busy"] is not None:
        r.line("INFO", "system busy", f"{base['busy']:.1f}% of all CPUs, {base['intr']:.0f} interrupts/s, {base['ctxt']:.0f} context switches/s")
    for cpu, name, pid in base["top"]:
        r.line("INFO", f"busiest {name}", f"{cpu:.2f}% of a core (pid {pid})")
    if discharging and base["draws"]:
        d = base["draws"]
        r.line("INFO", "idle draw", f"{mean(d):.0f} mW mean (min {min(d):.0f}, max {max(d):.0f}, {len(d)} readings)")
        full, volt = num(b / "charge_full"), num(b / "voltage_now")
        cap = num(b / "capacity")
        if full and volt and cap is not None:
            wh = full * volt / 1e12 * cap / 100
            r.line("INFO", "idle time left", f"{wh / (mean(d) / 1000):.1f} h at this draw ({cap}% of {full / 1000:.0f} mAh)")

    r.step("the hot-plug daemon")
    h = base["procs"].get("hotplug")
    if h is None:
        r.line("FAIL", "hotplug daemon", "r3i6nos-hotplug start is not running, so its cost cannot be measured (docs/HOTPLUG.md)")
    else:
        r.line("PASS" if h["cpu"] <= GOAL_DAEMON_CPU else "FAIL", "hotplug cpu", f"{h['cpu']:.2f}% of a core (goal at most {GOAL_DAEMON_CPU:.1f}%)")
        r.line("PASS" if h["wake"] <= GOAL_DAEMON_WAKEUPS else "FAIL", "hotplug wakeups", f"{h['wake']:.1f}/s (goal at most {GOAL_DAEMON_WAKEUPS:.1f}; its poll is once a second)")
        r.line("INFO", "hotplug memory", f"{h['rss']} kB resident")
    cost = job_cost([HOTPLUG, "status"], {})
    r.line("INFO" if cost else "SKIP", "hotplug one look", f"{cost[0] * 1000:.0f} ms CPU, {cost[1] * 1000:.0f} ms wall (status: every sysfs read the daemon does each poll, plus Python's start)" if cost else "r3i6nos-hotplug status would not run")
    m = base["procs"].get("menu")
    if m is None:
        r.line("SKIP", "menu", f"no process matching {MENU_MATCH} (run from Settings > Device reports, so the menu is showing)")
    else:
        r.line("INFO", "menu cpu", f"{m['cpu']:.1f}% of a core while showing, {m['rss']} kB resident (every frame polls the toast; the battery is read every 10 s)")

    r.step("the periodic jobs")
    jobs, total = [], 0.0
    with tempfile.TemporaryDirectory(prefix="r3i6nos-power.") as tmp:
        for name, cmd, env, per_hour in (
            ("battery sample tick", [BATTERY_CMD, "sample", "tick", "power-report"], {"R3I6NOS_BATTERY_DIR": tmp}, 12),
            ("bootstate", [BOOTSTATE_CMD], {"R3I6NOS_BOOTSTATE": os.path.join(tmp, "boot-state")}, 12),
        ):
            c = job_cost(cmd, env)
            if c is None or not Path(cmd[0]).exists():
                r.line("SKIP", f"job {name}", f"{cmd[0]} would not run here")
                continue
            share = c[0] * per_hour / 3600 * 100
            total += share
            r.line("INFO", f"job {name}", f"{c[0] * 1000:.0f} ms CPU, {c[1] * 1000:.0f} ms wall a run, {per_hour} runs an hour = {share:.4f}% of a core")
            jobs.append(name)
    if jobs:
        r.line("PASS" if total <= GOAL_JOBS_CPU else "FAIL", "jobs cpu", f"{total:.4f}% of a core averaged, for {', '.join(jobs)} (goal at most {GOAL_JOBS_CPU}%; bootstate run as this user, so systemctl fails fast and its cost here is a lower bound)")
    r.line("SKIP", "job clock save", "hourly, root, writes the card: not run here; one small file an hour")

    r.step("the hot-plug daemon stopped, then started again")
    if not discharging:
        r.line("SKIP", "hotplug draw", "needs the battery discharging with current_now (see above)")
    elif h is None:
        r.line("SKIP", "hotplug draw", "the daemon is not running")
    elif os.geteuid() != 0 and not ENV("R3I6NOS_POWER_AB"):
        r.line("SKIP", "hotplug draw", "stopping a root service needs root: run `sudo r3i6nos-report` over SSH for the stop-and-compare")
    else:
        pid = pids["hotplug"]
        try:
            os.kill(pid, signal.SIGSTOP)
            try:
                off = measure(POWER_S, {}, b)
            finally:
                os.kill(pid, signal.SIGCONT)        # always started again, whatever happened
        except OSError as e:
            r.line("SKIP", "hotplug draw", f"could not stop the daemon: {e}")
            off = None
        if off and off["draws"]:
            on2 = measure(POWER_S, {}, b)
            a, c, d = mean(base["draws"]), mean(off["draws"]), mean(on2["draws"])
            noise = abs(a - d)
            cost_mw = (a + d) / 2 - c
            r.line("INFO", "draw running / stopped / running", f"{a:.0f} / {c:.0f} / {d:.0f} mW (the two running windows differ by {noise:.0f} mW: that is the noise)")
            over = cost_mw - noise
            r.line("PASS" if over <= GOAL_DAEMON_MW else "FAIL", "hotplug draw",
                   f"about {cost_mw:.0f} mW ({cost_mw / ((a + d) / 2) * 100:.1f}% of the idle draw), {max(over, 0):.0f} mW beyond the noise (goal at most {GOAL_DAEMON_MW:.0f} mW)")
    r.line("INFO", "reading this", "one window each, on one battery: a short test. Repeat on charge levels 100%, 50%, 20% and on a warm unit before trusting a small number")


def demo_recording():
    """True while a Rec demo holds /run/loveos/demo/lock with a live pid (docs/DEMO-RECORDINGS.md: the unit's whole power is its)."""
    try:
        pid = int(Path(os.environ.get("R3I6NOS_RUN", "/run/loveos") + "/demo/lock").read_text().split()[0])
        os.kill(pid, 0)
    except PermissionError:
        return True
    except (OSError, ValueError, IndexError):
        return False
    return True


def main(argv):
    quiet = "--quiet" in argv
    if demo_recording():
        print("r3i6nos-report: a Rec demo is recording; the unit's whole power is its until it ends", file=sys.stderr)
        return 75
    how = "Settings > Device reports" if "--from-settings" in argv else "r3i6nos-report"
    rel = keyvals(ETC / "r3i6nos-release")
    cards = keyvals(STATE)
    try:
        folder, card = where(cards)
        r = Report(folder, how, rel.get("VERSION", "?"), card, quiet)
        r.steps = 9 + 2 * len(mounted_cards(cards))
    except OSError as e:
        print(f"r3i6nos-report: cannot write the report: {e}", file=sys.stderr)
        return 1
    for part in (lambda: (system(r, rel), setup_section(r)), lambda: boot(r), lambda: sound(r), lambda: clock(r), lambda: storage(r, cards), lambda: power_section(r)):
        try:
            part()
        except Exception as e:  # a broken check is a line in the report, never a missing report
            r.line("FAIL", "report", f"a check crashed: {e}")
    r.close()
    r.step("done")
    if not quiet:
        print(f"written: {r.path}")
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
