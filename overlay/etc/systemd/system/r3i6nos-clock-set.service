[Unit]
Description=Set the date, time and time zone a person chose in the menu
Documentation=file:/usr/local/bin/r3i6nos-clock
# Started by r3i6nos-clock-set.path; never wanted by a target. Deletes the request, checks it, sets the clock, writes /run/r3i6nos-clock/result.

[Service]
Type=oneshot
ExecStart=/usr/local/bin/r3i6nos-clock apply
TimeoutStartSec=30
