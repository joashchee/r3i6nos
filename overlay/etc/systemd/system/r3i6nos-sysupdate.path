[Unit]
Description=Watch for a system package the login user staged (r3i6nos-pkg get)
# Only WATCHES a file. The helper installs nothing that is not signed by the catalog's key (docs/PACKAGES-OTA.md, "System updates").

[Path]
PathExists=/run/loveos/sysupdate/request
Unit=r3i6nos-sysupdate.service

[Install]
WantedBy=multi-user.target
