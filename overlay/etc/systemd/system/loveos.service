[Unit]
Description=r3i6nos menu and game session
# The cards are mounted by role (docs/STORAGE.md): /roms (system card) and /roms2 (data card).
After=local-fs.target r3i6nos-cards.service sound.target
Wants=r3i6nos-cards.service
# The menu owns the screen: no login prompt on tty1.
Conflicts=getty@tty1.service
After=getty@tty1.service

[Service]
Type=simple
User=loveos
Group=loveos
SupplementaryGroups=video audio input render
RuntimeDirectory=loveos
# The battery history (Settings > Battery): /var/lib/r3i6nos-battery, owned by loveos, kept across reboots.
StateDirectory=r3i6nos-battery
Environment=SDL_VIDEODRIVER=kmsdrm
Environment=SDL_NOMOUSE=1
Environment=HOME=/home/loveos
# SDL's KMS/DRM driver wants a VT to switch modes on.
TTYPath=/dev/tty1
StandardInput=tty-force
TTYReset=yes
TTYVHangup=yes
StandardOutput=journal
StandardError=journal
ExecStart=/usr/local/bin/loveos-session
# on-failure, not always: Settings > Shutdown ends the session with exit 0 and must stay stopped.
Restart=on-failure
RestartSec=2
# "+" = runs as root: powers the device off when the session left the poweroff flag.
ExecStopPost=+/usr/local/bin/r3i6nos-poweroff

[Install]
WantedBy=multi-user.target
