#!/bin/bash
### BEGIN INIT INFO
# Provides:          loveos
# Required-Start:    $local_fs $syslog
# Default-Start:     5
# Description:       Boot straight to the r3i6nos menu
### END INIT INFO
#
# The menu is a LÖVE 11.5 app (menu/). It writes the chosen entry to
# /run/loveos/next as "<type><TAB><path>" and quits; this loop runs it
# through run_app.sh, so the menu's memory is free while a game runs.

NEXT_DIR=/run/loveos
NEXT="$NEXT_DIR/next"
MENU=/opt/loveos/menu

loop() {
    export SDL_VIDEODRIVER=kmsdrm
    export SDL_NOMOUSE=1
    mkdir -p "$NEXT_DIR"

    while true; do
        # Pick up any .deb dropped on the card since the last pass.
        python3 /usr/local/bin/deb_watcher.py

        rm -f "$NEXT"
        /opt/love/11.5/bin/love "$MENU"
        [ -f "$NEXT" ] || { sleep 1; continue; }

        IFS=$'\t' read -r type target < "$NEXT"
        /usr/local/bin/run_app.sh "$type" "$target"
    done
}

case "${1:-start}" in
    start) loop > /var/log/loveos.log 2>&1 & ;;
    stop)  pkill -f 'loveos' ;;
    *)     echo "Usage: $0 {start|stop}" >&2; exit 1 ;;
esac
