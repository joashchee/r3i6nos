# OS / editor
.DS_Store
.vscode/*
!.vscode/extensions.json
.idea/

# Build output and images: large, rebuilt by scripts, never committed
build/
out/
dist/
*.img
*.img.xz
*.img.gz
*.deb
*.love

# Captured from the user's own card: the board vendor's files, never published
local_hardware_assets*
*.zip

# Firmware vendor trees fetched by scripts (dArkOS, kernels, rootfs)
vendor/

# Python
__pycache__/
*.pyc

# Claude Code local state
.claude/settings.local.json
.claude/.cc-writes/
CLAUDE.local.md
# ... except the test corpus's own .love and .deb, which are committed (corpus/README.md; tests/test_corpus.py checks every file is tracked)
!corpus/files/*.love
!corpus/files/*.deb
