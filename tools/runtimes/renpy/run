#!/bin/bash
# r3i6nos-run-renpy <folder that holds game/> [args]
# Runs a Ren'Py game with the runtime in this package (its own Python, py3-linux-aarch64) and the image's SDL2. Needs no root and no mount.
HERE="$(cd "$(dirname "$(readlink -f "$0")")/.." && pwd)"
RT="$HERE/lib/r3i6nos-runtimes/renpy"
[ -n "${1:-}" ] || { echo "usage: r3i6nos-run-renpy <folder that holds game/> [args]" >&2; exit 2; }
game="$1"; shift
[ -d "$game/game" ] || { echo "r3i6nos-run-renpy: $game has no game/ folder" >&2; exit 2; }
exec "$RT/startRENPY" "$(cd "$game" && pwd)" "$@"
